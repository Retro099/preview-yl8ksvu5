---
import Base from '../../layouts/Base.astro';
import { CONTACT as C } from '../../config';
export { paths as getStaticPaths } from '../../data/paths';
const { lang } = Astro.params; const ja = lang==='ja';
const ART = {
 call:`<svg class="art" viewBox="0 0 160 90" aria-hidden="true" focusable="false"><rect x="58" y="10" width="44" height="72" rx="8" fill="#fff" stroke="#2B4C7E" stroke-width="2"/><rect x="64" y="20" width="32" height="44" rx="3" fill="#EEF2F8"/><circle cx="80" cy="73" r="3" fill="#2B4C7E" opacity=".5"/><path d="M68 34q12-10 24 0" stroke="#C8553D" stroke-width="2" fill="none" stroke-linecap="round"/><circle cx="80" cy="42" r="6" fill="#FFF8EC" stroke="#2B4C7E" stroke-width="1.6"/><path d="M110 30q8 8 0 16M118 24q14 14 0 28" stroke="#D9A441" stroke-width="2" fill="none" stroke-linecap="round"/><text x="34" y="52" font-size="13" text-anchor="middle" fill="#2B4C7E" opacity=".7">20′</text></svg>`,
 recruiter:`<svg class="art" viewBox="0 0 160 90" aria-hidden="true" focusable="false"><rect x="18" y="16" width="62" height="34" rx="10" fill="#fff" stroke="#2B4C7E" stroke-width="2"/><path d="M30 50l-4 10 12-10" fill="#fff" stroke="#2B4C7E" stroke-width="2" stroke-linejoin="round"/><path d="M30 28h38M30 37h26" stroke="#2B4C7E" stroke-width="2" stroke-linecap="round" opacity=".45"/><rect x="86" y="38" width="56" height="30" rx="10" fill="#FBEFF1" stroke="#C8553D" stroke-width="2"/><path d="M128 68l4 9-12-9" fill="#FBEFF1" stroke="#C8553D" stroke-width="2" stroke-linejoin="round"/><path d="M96 49l4 4 8-8M114 51h18" stroke="#C8553D" stroke-width="2" fill="none" stroke-linecap="round"/><text x="114" y="26" font-size="12" text-anchor="middle" fill="#2B4C7E" opacity=".7">Q25</text></svg>`,
 guide:`<svg class="art" viewBox="0 0 160 90" aria-hidden="true" focusable="false"><path d="M48 14h56l8 8v58H48Z" fill="#fff" stroke="#2B4C7E" stroke-width="2" stroke-linejoin="round"/><path d="M104 14v8h8" fill="none" stroke="#2B4C7E" stroke-width="2"/><circle cx="62" cy="62" r="4" fill="#D9A441"/><circle cx="98" cy="32" r="5" fill="none" stroke="#C8553D" stroke-width="2"/><circle cx="98" cy="32" r="1.8" fill="#C8553D"/><path d="M62 62q6-14 18-12t16-14" stroke="#2B4C7E" stroke-width="2" stroke-dasharray="3 3" fill="none"/><path d="M40 20v56" stroke="#D9A441" stroke-width="4" stroke-linecap="round" opacity=".6"/><text x="80" y="76" font-size="9" text-anchor="middle" fill="#2B4C7E" opacity=".6">1 · 2 · 3 · 4</text></svg>`,
};
const offers = ja ? [
 ['call','t-ai','日本への道','インドから日本へ：あなたの道をチェック','20分の通話です。あなたの状況を見ながら、日本へのどの道を調べる価値があるかを、私自身の経験から一緒に話します。'],
 ['recruiter','t-sakura','日本での就職準備','採用面談の準備','25問の「採用面談キット」と30分の練習通話です。日本の会社との面談を準備している人のためのものです。'],
 ['guide','t-gold','日本への道','インドから日本へ：道のりガイド','インドから日本への主な方法（仕事、JET、MEXT、日本語学校）を、手順と公式の情報源つきでまとめた4ページのガイドです。'],
] : [
 ['call','t-ai','Japan routes','Japan from India: your route check','A 20-minute call to look at your situation and talk through which routes into Japan are worth exploring, from my own experience.'],
 ['recruiter','t-sakura','Japan job prep','Recruiter call ready','The 25-question Recruiter Call Kit plus a 30-minute practice call, for people preparing for a conversation with a Japanese company.'],
 ['guide','t-gold','Japan routes','Japan from India: Route Guide','A 4-page guide to the main ways into Japan from India (work, JET, MEXT, language school), with steps and official sources.'],
];
const URL = {call:'https://topmate.io/prithivi_raj_mohanta/2372881', recruiter:'https://topmate.io/prithivi_raj_mohanta/2374750', guide:'https://topmate.io/prithivi_raj_mohanta/2374571'};
const _b = import.meta.env.BASE_URL; const B = _b.endsWith('/') ? _b.slice(0, -1) : _b;
const nt = ja ? '（新しいタブで開きます）' : ' (opens in a new tab)';
---
<Base lang={lang} page="talk" title={ja?'1対1の相談':'Book a 1:1 chat'} description={ja?'Topmateで受けられる相談とガイドから、3つを紹介します。':'Three featured 1:1 chats and guides on Topmate.'}>
<h1>{ja?'1対1の相談':'Book a 1:1 chat'}</h1>
<section class="offers" aria-label={ja?'おすすめの3つ':'Three featured offers'}>
{offers.map(([a,t,g,name,line]) => <article class={`offer card ${t}`}>
<span class="artw" set:html={ART[a]}/>
<p class="og">{g}</p>
<h2>{name}</h2>
<p>{line}</p>
<a class="olink" href={URL[a]} target="_blank" rel="noopener" aria-label={`${name}${ja?'：Topmateで見る':': view on Topmate'}${nt}`}>{ja?'Topmateで見る ↗':'View on Topmate ↗'}</a>
</article>)}
</section>
<p class="allw"><a class="btn" href={C.topmate} target="_blank" rel="noopener">{ja?'Topmateですべて見る':'See all on Topmate'} ↗<span class="sr">{nt}</span></a></p>
<p class="mut small">{ja?'予約と支払いはTopmateで行います。':'Booking and payment happen on Topmate.'}</p>
<p class="mut small">{ja?'仕事の依頼は':'For paid project work, see '}<a href={`${B}/${lang}/work/`}>{ja?'こちら':'Work with me'}</a>{ja?'。':'.'}</p>
</Base>
