---
export { paths as getStaticPaths } from '../../data/paths';
const { lang } = Astro.params;
const _b = import.meta.env.BASE_URL; const B = _b.endsWith('/') ? _b.slice(0, -1) : _b;
const to = `${B}/${lang}/talk/`;
---
<html lang={lang}><head><meta charset="utf-8"><meta name="robots" content="noindex, nofollow"><meta http-equiv="refresh" content={`0; url=${to}`}><link rel="canonical" href={to}><title>→</title></head><body><a href={to}>{lang==='ja'?'1対1の相談':'Book a 1:1 chat'}</a></body></html>
