---
import Base from '../../../layouts/Base.astro'; import J from '../../../components/J.astro';
export { paths as getStaticPaths } from '../../../data/paths';
import { projects } from '../../../data/projects'; import FlashDeck from '../../../components/FlashDeck.astro'; import { skills } from '../../../data/profile';
const { lang } = Astro.params; const ja = lang==='ja';
const _b = import.meta.env.BASE_URL; const B = _b.endsWith('/') ? _b.slice(0, -1) : _b;
---
<Base lang={lang} page="projects" title={ja?'プロジェクト':'Projects'}>
<h1>{ja?'プロジェクト':'Projects'}</h1>
<FlashDeck lang={lang}/>
<section class="narrow skillsec"><h2>{ja?'スキル':'Skills'}</h2><ul class="skills bento">{skills.map(([e,j,he,hj,sl]) => <li><strong class="sk">{ja?j:e}</strong>{he && <span class="use"><span class="ul">{ja?'会社での使い方：':'How this helps a company: '}</span>{ja?hj:he} <a href={`${B}/${lang}/projects/${sl}/`}>{ja?'プロジェクトを見る':'See the project'}<span class="sr"> ({ja?j:e})</span></a></span>}</li>)}</ul></section>
</Base>
