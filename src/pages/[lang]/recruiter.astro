---
import Base from '../../layouts/Base.astro';
import Contact from '../../components/Contact.astro';
export { paths as getStaticPaths } from '../../data/paths';
import m from '../../data/metrics.json';
const { lang } = Astro.params; const L = lang==='ja' ? 'ja' : 'en'; const ja = L==='ja';
const _b = import.meta.env.BASE_URL; const B = _b.endsWith('/') ? _b.slice(0, -1) : _b;
const c=m.crm, r=m.rag, f=m.fraud;
const ref=(u)=>u+(u.includes('?')?'&':'?')+'ref=recruiter';
const GH='https://github.com/Retro099/';
const LG=(n)=>`${B}/logos/${n}`;
// Advisors: fill when real names arrive. { name, email, role, roleJa, inst, instJa }. No quotes.
// Roles unknown (letters unreadable): add role:'…', roleJa:'…' here later and it renders after the name.
const ADVISORS = [
 { name:'Manisha Devi', email:'manisha.devi@gift.edu.in', inst:'GIFT Autonomous College, Bhubaneswar', instJa:'GIFT Autonomous College（ブバネーシュワル）' },
 { name:'Nibedita Sahoo', email:'nibedita.sahoo@galgotiasuniversity.edu.in', inst:'Galgotias University, Greater Noida', instJa:'Galgotias University（グレーター・ノイダ）' } ];
const T = {
 en:{ h1:'Software, data and AI/ML engineer', h1b:'(Python, LLM evaluation)',
  top:'Based in India, open to relocating, including overseas, with visa sponsorship and relocation support. Japan is my main goal.',
  intent:'Looking for roles with work-visa sponsorship, Japan first. I’ll relocate after an offer and visa approval. Studying Japanese daily.',
  nav:['Projects','Work','Contact'], getsH:'What a company gets',
  gets:[['Checking AI answers against written rules','LLM evaluation: I check AI answers against a company’s written rules, find where they are wrong or unsafe, explain why, and build test sets that show whether a change helped.'],
   ['Working systems in Python','Data and ML pipelines that run: Japanese meeting notes to CRM fields (with a live app), a Japanese document search (RAG) evaluation, and credit-card fraud detection. Each reports what was tested and on how many cases.'],
   ['Game development','At GodSpeed Games I worked on Bunny Park (Xbox, PS4, PC) in Unreal Engine 4 and C++: localization, testing on handheld devices, and porting to handheld devices, including touch controls.'],
   ['This website, end to end','Built with Astro and TypeScript, in 4 languages (English, Japanese, French, Russian), checked at phone and desktop widths in light and dark mode, and deployed to GitHub Pages.'],
   ['A private local agent pipeline','I built a private local pipeline of AI agents. The site versions in the “How this site was built” timeline were built with it. The repository is not public.'],
   ['Remote work in international teams','Since Jun 2024 I have worked remotely with international teams across time zones, and I report problems early.']],
  projH:'Projects', st:'Status', what:'What it does', who:'Who it helps', steps:'See the steps', gh:'View on GitHub', live:'Try live app', docs:'Docs', docsN:'same README in two languages', onreq:'Repository available on request',
  jobH:'What I do: checking AI answers against written rules',
  job:['Companies use AI to answer customers and staff.','I test those answers before people rely on them: I write hard questions, find where the AI is wrong or unsafe, explain why, and check the code behind it.','The company gets fewer wrong answers, and a test set that shows whether a change really made the AI better.'],
  jobO:'Outlier AI is a platform operated by Scale AI where companies hire remote specialists to test and improve AI models. I do this as remote contract work from India.',
  typesH:'Types of projects', types:[['Checking AI answers against written rules','Rubric evaluation, error rating, clear written explanations'],['Image and chart questions that make AI fail','Computer vision, reading line graphs and charts, adversarial question writing, written critique'],['Checking the AI judges','LLM-as-judge, consistent grading, attention to detail'],['Code and speed checks behind the answers','Python, reading code, performance tuning'],['Building test sets','Dataset building, prompt writing, quality checks']],
  typesNote:'These are descriptive names, not the original project names.', sk:'Skills',
  bgH:'About me',
  bg:['My strength is helping a team do careful, reliable work. On my current client team I train new members: I explain the guidelines, walk through real examples with them, and keep giving feedback until they can work alone. At a game studio I mentored interns and junior developers every day and reviewed their work.','I like working with others. At college I was on the core team of the tech festival and co-organised coding and bug-finding events, and from 2020 to 2021 I led weekly sessions for junior students. At school I was Vice Captain.','I try to stay humble and keep learning. I practise my weakest skill, speaking, on purpose, and I am studying Japanese. I also speak English, Hindi, Odia and Bengali.',
   'Impact: I catch where AI answers break the written rules before customers see them, and write it up so the team can fix it. Since Jun 2024 I have worked remotely with international teams on Outlier, across time zones. I have studied Japanese every day since Aug 2025 and have talked with friends in Japan on HelloTalk since Mar 2024. I report problems early, while they are still easy to fix.'],
  q1:'I want students to feel it is okay to get it wrong. A mistake just means someone tried.',
  q2:'I want to be part of the community, not just a visitor.', q2n:'In Japan I plan to learn the local rules, such as garbage sorting and quiet hours, greet my neighbours first, and speak politely to earn trust. I am planning for the long term.',
  refH:'Advised by', refs:'References available on request.',
  coH:'Where I have worked', coScr:'Work history (scrollable)', now:'present',
  work:[{l:['outlier.svg','scale.svg'],n:'Outlier AI, a Scale AI platform',y:'Jun 2024 – present',d:'Remote. LLM evaluation, including safety testing and multimodal tasks.'},
   {l:['mercor.svg','turing.webp'],n:'Self-employed: Mercor and Turing',y:'Jul 2023 – May 2024',d:'Data-science and data-cleaning projects.'},
   {l:['godspeed.webp'],n:'GodSpeed Games',s:'Project: Bunny Park',pi:'bunnypark-banner.webp',y:'Jun 2022 – Jun 2023',d:'Remote, full-time. Unreal Engine 4 and C++: localization, handheld testing and porting, touch controls.'}],
  afH:'Organizations and firms I’m affiliated with', afN:'Logos are trademarks of their owners.',
  ctH:'Contact', sw:'Language' },
 ja:{ h1:'ソフトウェア・データ・AI/MLのエンジニアです。', h1b:'',
  top:'インド在住で、ビザサポートのある海外での就業にも前向きで、特に日本で働きたいと考えています。',
  intent:'ビザサポートのある企業で働きたいと考えています（日本を第一希望）。内定後、ビザ申請と引っ越しの準備を進めます。毎日日本語を勉強しています。',
  nav:['プロジェクト','職歴','連絡先'], getsH:'会社にとってのメリット',
  gets:[['書かれたルールに照らしたAIの回答の確認','LLMの評価：会社のルールに照らしてAIの回答を確認し、まちがいや危ない答えを見つけて理由を説明し、変更で本当に良くなったかを確かめるテストを作ります。'],
   ['Pythonで動くシステム','実際に動くデータ・MLのパイプライン：日本語の商談メモからCRM項目へ（動くアプリあり）、日本語の文書検索（RAG）の評価、クレジットカードの不正検出。何を何件テストしたかを、それぞれ書いています。'],
   ['ゲーム開発','GodSpeed Gamesで、Unreal Engine 4とC++を使い「Bunny Park」（Xbox、PS4、PC）を担当しました。ローカライズ、携帯機でのテスト、携帯機への移植（タッチ操作も）をしました。'],
   ['このサイトを最初から最後まで','AstroとTypeScriptで作り、4言語（英語・日本語・フランス語・ロシア語）に対応。スマホとパソコンの幅、ライトとダークで確認し、GitHub Pagesで公開しています。'],
   ['自分で作ったローカルのエージェントの仕組み','AIエージェントを使う、非公開のローカルの仕組みを作りました。「このサイトの作り方」の記録にある版は、これで作りました。リポジトリは公開していません。'],
   ['海外のチームとのリモートの仕事','2024年6月から、時差のある海外のチームとリモートで働いています。問題は早めに報告します。']],
  projH:'プロジェクト', st:'状況', what:'できること', who:'役に立つ人', steps:'流れを見る', gh:'GitHubで見る', live:'動くアプリを試す', docs:'資料', docsN:'同じREADMEの英語版と日本語版', onreq:'リポジトリはご依頼があればお見せします',
  jobH:'私の仕事：AIの回答を、書かれたルールに照らして確認する',
  job:['会社はAIを使ってお客さんや社員に答えます。','私はその答えを、人が使う前にテストします。難しい質問を作り、まちがいや危ない答えを見つけて理由を説明し、裏のコードもチェックします。','会社はまちがいが減り、変更で本当に良くなったかを確かめられます。'],
  jobO:'Outlier AIは、Scale AIが運営するプラットフォームで、企業がリモートの専門家に頼んでAIモデルをテストし、改善します。私はインドからリモートの業務委託として働いています。',
  typesH:'案件の種類', types:[['ルールに沿ったAIの答えの確認','ルーブリック評価、誤りの評価、分かりやすい説明文'],['AIがまちがえる画像・グラフの問題づくり','画像認識、折れ線グラフ・図表の読み取り、敵対的な質問づくり、講評'],['AIの採点者（AIジャッジ）の確認','LLM-as-judge、ぶれない採点、細部への注意'],['答えの裏のコードと速さのチェック','Python、コードの読解、性能改善'],['テストセットの作成','データセット作成、プロンプト作成、品質チェック']],
  typesNote:'内容を表す名前で、実際の案件名ではありません。', sk:'必要なスキル',
  bgH:'自己PR',
  bg:['私の強みは、チームが正確で信頼できる仕事をできるよう支えることです。いまのクライアントのチームでは新しいメンバーの指導を担当し、ガイドラインを説明して実例を一緒に確認し、ひとりで作業できるまでフィードバックを続けています。ゲーム会社でも、インターンや若手開発者を毎日指導し、作業を確認していました。','人と協力して進める仕事が好きです。大学では技術祭の中心メンバーとして、プログラミングやバグ探しのイベントを共同で運営し、2020〜2021年には後輩向けの勉強会を毎週開きました。学校では副キャプテンを務めました。','謙虚に学び続けることを大切にしています。いちばん苦手な「話す」力をあえて練習し、日本語も勉強中です。英語・ヒンディー語・オディア語・ベンガル語を話します。'],
  q1:'まちがえても大丈夫だと、生徒に感じてほしいです。まちがいは、挑戦したしるしです。',
  q2:'ただの訪問者ではなく、地域の一員になりたいです。', q2n:'日本では、ごみの分別や静かにする時間などの地域のルールを学び、自分から近所の人にあいさつし、ていねいな言葉で信頼をきずきたいと考えています。長く住むつもりです。',
  refH:'指導', refs:'推薦者の情報はご依頼があればお伝えします。',
  coH:'これまでの仕事先', coScr:'職歴（スクロールできます）', now:'現在',
  work:[{l:['outlier.svg','scale.svg'],n:'Outlier AI（Scale AIのプラットフォーム）',y:'2024年6月〜現在',d:'リモート。LLMの回答の評価（安全性テスト、マルチモーダルを含む）。'},
   {l:['mercor.svg','turing.webp'],n:'個人事業主：MercorとTuring',y:'2023年7月〜2024年5月',d:'データ分析とデータ整理の案件。'},
   {l:['godspeed.webp'],n:'GodSpeed Games',s:'プロジェクト：Bunny Park',pi:'bunnypark-banner.webp',y:'2022年6月〜2023年6月',d:'リモート、正社員。Unreal Engine 4とC++で、ローカライズ、携帯機でのテストと移植、タッチ操作。'}],
  afH:'関わりのある組織・企業', afN:'ロゴは各社の商標です。',
  ctH:'連絡先', sw:'言語' } }[L];
const AF = [['Outlier AI','outlier.svg'],['Scale AI','scale.svg'],['Mercor','mercor.svg'],['Turing','turing.webp'],['GodSpeed Games','godspeed.webp'],['Topmate','topmate-wordmark.png',1]];
const P = [
 { main:true, gh:GH+'jp-meeting-to-crm-fields', live:'https://retro-jp-meeting-to-crm-fields.streamlit.app/', docs:[GH+'jp-meeting-to-crm-fields/blob/main/README.md',GH+'jp-meeting-to-crm-fields/blob/main/README.ja.md'], vis:['note','json','check','person','copy'],
   en:{ t:'Japanese meeting notes to CRM fields', st:'Finished, stable on main, CI green (30 Oct 2026)', what:'Turns Japanese meeting notes into five CRM fields: contact, company, deadline, next action, risk.', who:'Sales and account teams in Japanese companies.',
     num:`${c.exact_match} exact match across ${c.exact_total} fields (${c.notes} synthetic notes x 5 fields), mean of ${c.runs} runs, temperature 0.`,
     extra:[`Attack success rate, lower is better: ${c.attack_before} to ${c.attack_after} with defenses on (held-out ${c.attacks} attacks, small test).`,`${c.judge_agree} of ${c.judge_total} sampled judge grades agreed with the judge (small sample).`],
     steps:['Paste a Japanese meeting note.','The model extracts the 5 fields as JSON.','Optional checks: security defenses, validate and repair.','A person reviews and edits the fields.','Copy or download the JSON for the CRM.'] },
   ja:{ t:'日本語の商談メモからCRM項目へ', st:'完成。mainで安定、CIは成功（2026年10月30日）', what:'日本語の商談メモから CRM の 5 項目（相手・会社名・期限・次アクション・リスク）を取り出します。', who:'日本企業の営業・アカウント担当。',
     num:`完全一致 ${c.exact_match}（${c.exact_total}項目＝テスト用メモ${c.notes}件×5項目、${c.runs}回の平均、temperature 0）`,
     extra:[`攻撃成功率（低いほど良い）：対策ありで${c.attack_before}から${c.attack_after}（未使用の攻撃${c.attacks}件、小規模なテスト）`,`抽出した評価${c.judge_total}件のうち${c.judge_agree}件で、判定が一致しました（小規模な確認）。`],
     steps:['商談メモを貼り付ける','モデルが 5 項目を JSON で抽出','任意で確認（セキュリティ防御・確認と修正）','担当者が確認・修正','JSON をコピー／ダウンロードして CRM へ'] } },
 { gh:GH+'japanese-rag-eval', docs:[GH+'japanese-rag-eval#readme'], vis:['note','bars','bars','check'],
   en:{ t:'Japanese document search evaluation', st:'Finished (one evaluation report)', what:'Tests whether AI search finds the right passage in a long Japanese government report.', who:'Teams building AI search over Japanese documents.',
     num:`Right passage in the top 5: ${Math.round(+r.hit5*100)}%, MRR ${r.mrr}, on ${r.questions} questions (${r.hand_checked} hand-checked).`, extra:[],
     steps:['Ask a question in Japanese.','Search finds candidate passages.','The top 5 passages are ranked.','Score: is the right passage in the top 5?'] },
   ja:{ t:'日本語の文書検索の評価', st:'完成（評価レポート1件）', what:'長い日本語の政府報告書から、AI検索が正しい部分を見つけられるかをテストします。', who:'日本語の文書でAI検索を作るチーム。',
     num:`${r.questions}問で、上位5件に正解 ${Math.round(+r.hit5*100)}%、MRR ${r.mrr}（うち${r.hand_checked}問は手で確認）`, extra:[],
     steps:['日本語で質問する','検索が候補の部分を探す','上位5件を並べる','正解が上位5件に入ったかを採点'] } },
 { gh:GH+'credit-card-fraud-detection', docs:[GH+'credit-card-fraud-detection#readme'], vis:['json','bars','check','note'],
   en:{ t:'Credit card fraud detection', st:'Finished (one public dataset, not yet tested on newer data)', what:'Flags card payments that may be fraud and shows why.', who:'Fraud and risk teams at payment companies.',
     num:`Recall ${f.recall}, precision ${f.precision}, on the public Kaggle ULB dataset (${f.fraud_rate} of payments are fraud).`, extra:[],
     steps:['Card payment data comes in.','A model scores each payment.','Likely fraud is flagged.','An explanation shows which details drove the score.'] },
   ja:{ t:'クレジットカードの不正検出', st:'完成（公開データ1つ、新しいデータでは未検証）', what:'不正かもしれないカードの支払いを見つけ、その理由を示します。', who:'決済会社の不正対策・リスク担当チーム。',
     num:`公開データ（Kaggle ULB、不正は${f.fraud_rate}）で、再現率 ${f.recall}、適合率 ${f.precision}`, extra:[],
     steps:['カードの支払いデータが入る','モデルが支払いごとに点数をつける','不正の可能性が高いものに印をつける','どの情報が点数に効いたかを説明'] } },
 { gh:GH+'preview-yl8ksvu5', docs:[], vis:['note','json','check','person','copy'],
   en:{ t:'This website', st:'Finished (v6.9, 31 Oct 2026)', what:'This site, in 4 languages, showing my projects with measured numbers.', who:'Recruiters and teams who want to check my work quickly.',
     num:'4 languages; every release checked at 360, 390, 430 and 1440 px wide, in light and dark mode.', extra:[],
     steps:['Write the page in English and Japanese.','Build it with Astro and TypeScript.','Automatic checks: translations and numbers.','Test at phone and desktop widths.','Deploy to GitHub Pages.'] },
   ja:{ t:'このサイト', st:'完成（v6.9、2026年10月31日）', what:'4言語のこのサイトで、プロジェクトを測った数字とともに紹介しています。', who:'私の仕事をすばやく確認したい採用担当者やチーム。',
     num:'4言語。毎回の公開で、幅360・390・430・1440px、ライトとダークで確認しています。', extra:[],
     steps:['英語と日本語でページを書く','AstroとTypeScriptで作る','自動チェック：翻訳と数字','スマホとパソコンの幅でテスト','GitHub Pagesで公開'] } },
 { gh:null, docs:[], vis:['note','json','check','check','copy'],
   en:{ t:'Site translation pipeline', st:'Finished (used for every release of this site)', what:'Keeps 4 language versions in step: English and Japanese written by hand, French and Russian from a dictionary script, and a build check for untranslated text.', who:'Teams shipping a product in several languages.',
     num:'The build stops if any English text has no French or Russian translation.', extra:[],
     steps:['Write the English and Japanese text.','A script builds the French and Russian dictionaries.','The build check looks for untranslated text.','The build stops until it is fixed.','The site is deployed in 4 languages.'] },
   ja:{ t:'サイトの翻訳の仕組み', st:'完成（このサイトの毎回の公開で使用）', what:'4言語をそろえます。英語と日本語は自分で書き、フランス語とロシア語は辞書のスクリプトで作り、未翻訳の文がないかをビルドで確認します。', who:'いくつもの言語で製品を出すチーム。',
     num:'英語の文にフランス語かロシア語の訳がないと、ビルドが止まります。', extra:[],
     steps:['英語と日本語の文を書く','スクリプトがフランス語とロシア語の辞書を作る','ビルドで未翻訳の文を確認','直るまでビルドを止める','4言語でサイトを公開'] } } ];
---
<Base lang={lang} page="recruiter" title={ja?'ソフトウェア・データ・AI/MLエンジニア':'Software, data and AI/ML engineer'} description={`${T.h1} ${T.h1b} ${T.top}`} footerContact={false}>
<div class="rec" data-i18n-skip lang={L}>
<div class="rsw" role="group" aria-label={T.sw}><a href={`${B}/en/recruiter/`} data-rl="en" aria-current={L==='en'?'true':undefined}>EN</a><a href={`${B}/ja/recruiter/`} data-rl="ja" lang="ja" aria-current={L==='ja'?'true':undefined}>日本語</a></div>
<h1 class="dsp">{T.h1}{T.h1b && <span class="h1b"> {T.h1b}</span>}</h1>
<p class="lead">{T.top}</p>
<p class="intent">{T.intent}</p>
<nav class="rnav" aria-label={ja?'このページ':'On this page'}><a href="#projects">{T.nav[0]}</a><a href="#work">{T.nav[1]}</a><a href="#contact">{T.nav[2]}</a></nav>

<h2 class="dsp">{T.getsH}</h2>
<div class="rg3">{T.gets.map(([h,p])=> <div class="card"><h3>{h}</h3><p>{p}</p></div>)}</div>

<h2 class="dsp" id="projects">{T.projH}</h2>
{P.map(p=>{const x=p[L]; const n=x.steps.length; return <article class={p.main?'card pj main':'card pj'}>
 <h3 class="pn dsp">{x.t}</h3>
 <p class="st"><span class="dot" aria-hidden="true"></span>{T.st}: {x.st}</p>
 <p><b>{T.what}:</b> {x.what}</p><p><b>{T.who}:</b> {x.who}</p>
 <p class="num">{x.num}</p>
 {x.extra.map(e=> <p class="mut">{e}</p>)}
 <details class="stp" style={`--n:${n}`}><summary>{T.steps}</summary><ol>{x.steps.map((s,i)=> <li style={`--i:${i}`}><span class={`vz v-${p.vis[i]}`} aria-hidden="true"><i></i><i></i><i></i></span><span>{s}</span></li>)}</ol></details>
 <div class="lk">{p.gh ? <a class="btn" href={ref(p.gh)}>{T.gh}</a> : <span class="mut onreq">{T.onreq}</span>}{p.live && <a class="btn ghost" href={ref(p.live)}>{T.live}</a>}</div>
 {p.docs.length===2 && <p class="docs">{T.docs}: README <a href={ref(p.docs[0])}>EN</a> | <a href={ref(p.docs[1])} lang="ja">日本語</a> <span class="mut">({T.docsN})</span></p>}
 {p.docs.length===1 && <p class="docs">{T.docs}: <a href={ref(p.docs[0])}>README (EN)</a></p>}
 {p.live && <p class="mut note">{T.slow ?? (ja?'モデル提供元が混雑している時は、遅くなることがあります。':'May be slow when the model provider is busy.')}</p>}
</article>})}

<section class="band"><h2 class="dsp">{T.jobH}</h2></section>
<div class="card">{T.job.map(j=> <p>{j}</p>)}<p class="mut">{T.jobO}</p><h3>{T.typesH}</h3><p class="mut note">{T.typesNote}</p><ul class="types">{T.types.map(([n,k])=> <li><b>{n}</b><span>{T.sk}: {k}</span></li>)}</ul></div>

<h2 class="dsp" id="work">{T.coH}</h2>
<ol class="wbox" tabindex="0" role="region" aria-label={T.coScr}>{T.work.map(w=> <li class="wr"><span class="wl">{w.l.map(l=> <img src={LG(l)} alt="" width="28" height="28" decoding="async"/>)}</span><span class="wx"><b class="wn">{w.n}</b>{w.s && <span class="ws">{w.pi && <img class="pth" src={LG(w.pi)} alt="Bunny Park" width="120" height="56" decoding="async"/>}{w.s}</span>}<span class="wy">{w.y}</span><span class="wd">{w.d}</span></span></li>)}</ol>

<h2 class="dsp">{T.afH}</h2>
<div class="tk" tabindex="0" role="region" aria-label={T.afH}><ul>{[0,1,2,3].map(k=> AF.map(([n,l,w])=> <li aria-hidden={k>0?'true':undefined}>{w ? <img class="tkw" src={LG(l)} alt={n} width="124" height="24" decoding="async"/> : <>{l ? <img src={LG(l)} alt="" width="24" height="24" decoding="async"/> : null}<span class={l?undefined:"wm"}>{n}</span></>}</li>))}</ul></div>
<p class="mut note">{T.afN}</p>

