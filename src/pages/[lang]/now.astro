---
import Base from '../../layouts/Base.astro'; import J from '../../components/J.astro';
export { paths as getStaticPaths } from '../../data/paths';
import { projects } from '../../data/projects';
const { lang } = Astro.params; const ja = lang==='ja';
const _b = import.meta.env.BASE_URL; const B = _b.endsWith('/') ? _b.slice(0, -1) : _b;
---
<Base lang={lang} recruiter={false} page="now" title={ja?'いま':'Now'}>
<h1>{ja?'いま、していること':'Now'}</h1>
<p class="when"><time datetime="2026-10-31">{ja?'2026年10月31日 更新':'Updated 31 Oct 2026'}</time></p>
{ja ? <ul>
<li><J tag="span" en="I study Japanese every day.">毎日日本語を勉強しています。</J></li>
<li><J tag="span" en="CRM project: finished, with a README and measured numbers. Looking for the next anchor project.">CRMプロジェクト：完成しました。READMEと測った数字があります。次の中心になるプロジェクトを探しています。</J></li>
<li><J tag="span" en="Building this website.">このサイトを作っています。</J></li>
</ul> : <ul>
<li>I study Japanese every day.</li>
<li>CRM project: finished, with a README and measured numbers. Looking for the next anchor project.</li>
<li>Building this site.</li>
</ul>}
</Base>
