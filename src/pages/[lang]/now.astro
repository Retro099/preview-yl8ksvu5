---
import Base from '../../layouts/Base.astro'; import J from '../../components/J.astro';
export { paths as getStaticPaths } from '../../data/paths';
import { projects } from '../../data/projects';
const { lang } = Astro.params; const ja = lang==='ja';
const _b = import.meta.env.BASE_URL; const B = _b.endsWith('/') ? _b.slice(0, -1) : _b;
---
<Base lang={lang} recruiter={false} page="now" title={ja?'いま':'Now'}>
<h1>{ja?'いま、していること':'Now'}</h1>
<p class="when"><time datetime="2026-10-25">{ja?'2026年10月25日 更新':'Updated Oct 25, 2026'}</time></p>
{ja ? <ul>
<li><J tag="span" en="Studying for JLPT N2 every day (the test is on December 6, 2026). I will update this after the result.">毎日、JLPT N2の勉強をしています（試験は2026年12月6日）。結果が出たら更新します。</J></li>
<li><J tag="span" en="The evaluation run for CRM project version 1.1 is paused.">CRMプロジェクトのバージョン1.1の評価は、いったん止めています。</J></li>
<li><J tag="span" en="Building this website.">このサイトを作っています。</J></li>
</ul> : <ul>
<li>Studying for JLPT N2 every day. The test is on Dec 6, 2026; I'll update this after the result.</li>
<li>The evaluation run for CRM project v1.1 is paused.</li>
<li>Building this site.</li>
</ul>}
</Base>
