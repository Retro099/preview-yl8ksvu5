---
import Base from '../../layouts/Base.astro';
export { paths as getStaticPaths } from '../../data/paths';
import Experience from '../../components/Experience.astro'; import Avatar from '../../components/Avatar.astro';
import m from '../../data/metrics.json'; import latest from '../../data/latest.json';
import { CONTACT as C } from '../../config';
const { lang } = Astro.params; const ja = lang==='ja';
const _b = import.meta.env.BASE_URL; const B = _b.endsWith('/') ? _b.slice(0, -1) : _b;
const P = (s) => `${B}/${lang}/projects/${s}/`;
const fmt = (d) => { const [y,mo,da] = d.split('-').map(Number); return ja ? `${mo}月${da}日` : new Date(Date.UTC(y,mo-1,da)).toLocaleDateString('en-GB',{day:'numeric',month:'short',timeZone:'UTC'}); };
const nums = [
 { slug:'meeting-notes-to-crm', v:`${m.crm.attack_before} → ${m.crm.attack_after}`,
   en:['Attacks that got through (before → after)', `On ${m.crm.attacks} attacks I wrote myself`],
   ja:['攻撃が通った割合（対策の前→後）', `自作の攻撃${m.crm.attacks}件での結果`] },
 { slug:'japanese-document-search', v:m.rag.hit5,
   en:['Japanese search: right passage in top 5', `${m.rag.questions} questions on one government report`],
   ja:['文書検索で正解が上位5件に入った割合', `政府の報告書1冊、${m.rag.questions}問での結果`] },
 { slug:'credit-card-fraud', v:`${m.fraud.recall} / ${m.fraud.precision}`,
   en:['Fraud caught / alerts correct', `Public dataset where ${m.fraud.fraud_rate} of payments are fraud`],
   ja:['不正の検出率 / 警告の正しさ', `不正が${m.fraud.fraud_rate}しかない公開データでの結果`] },
];
const now = ja
 ? [['2026-10-25','JLPT N2の教材の勉強を始めました（第1課から）。2026年12月6日にN2を受けます。'],['2026-10-25','CRMプロジェクト：テストを増やした大きな評価を実行中です。今は一時停止しています。終わったら結果をのせます。'],['','このサイトを作っています。']]
 : [['2026-10-25','Started the JLPT N2 syllabus (Lesson 1). Taking N2 on 6 Dec 2026.'],['2026-10-25','CRM project: a larger evaluation run with more tests is in progress, currently paused. Results will be added when it is done.'],['','Building this site.']];
---
<Base lang={lang} title={ja?'ホーム':'Home'}>
<div class="hero4">
<Avatar size={112}/>
<div>
{ja ? <>
<p class="hi">こんにちは。</p>
<h1>プリティヴィ・ラージ・モハンタ</h1>
<p class="title">AI / MLエンジニア — LLMの評価、日本語AI、ゲーム開発</p>
<p class="lead">業務委託でAIの回答を評価し、個人では日本語の文書を扱う小さなAIツールを作っています。テストの方法と結果も、プロジェクトごとに公開しています。</p>
</> : <>
<p class="hi">Hello, I'm</p>
<h1>Prithivi Raj Mohanta</h1>
<p class="title">AI / ML engineer — LLM evaluation, Japanese-language AI, game development</p>
<p class="lead">I evaluate AI answers as a contractor and build small AI tools for Japanese text, and each project page shows how I tested it.</p>
</>}
</div></div>

<section class="nums" aria-label={ja?'数字で見る':'In numbers'}>
{nums.map(n => <a class="num card" href={P(n.slug)}><strong>{n.v}</strong><span>{ja?n.ja[0]:n.en[0]}</span><small>{ja?n.ja[1]:n.en[1]} →</small></a>)}
</section>
<p class="mut small">{ja?'どれも小さなテストでの数字です。条件と弱い点は各プロジェクトのページに書いています。':'All three come from small tests. Each project page explains the setup and the weak spots.'}</p>

<dl class="status">
<div><dt>{ja?'拠点':'Based'}</dt><dd>{ja?'インド・オディシャ州（リモート）':'Odisha, India (remote)'}</dd></div>
<div><dt>{ja?'日本語':'Japanese'}</dt><dd class="chip">{ja?'2026年12月6日にJLPT N2受験':'Taking JLPT N2 on Dec 6, 2026'}</dd></div>
<div><dt>{ja?'現在':'Currently'}</dt><dd>{ja?'日本企業の選考を受けています':'In the hiring process with Japanese companies'}</dd></div>
</dl>

<section class="split">
<div class="card"><h2>{ja?'いま':'Now'}</h2>
<p class="mut"><time datetime="2026-10-25">{ja?'2026年10月25日 更新':'Updated 25 Oct 2026'}</time></p>
<ul class="dated">{now.map(([d,t]) => <li>{d ? <time datetime={d}>{fmt(d)}</time> : <span></span>}<span>{t}</span></li>)}</ul>
<a href={`${B}/${lang}/now/`}>{ja?'くわしく →':'More on the Now page →'}</a></div>
<div class="card"><h2>{ja?'最近の更新（GitHub）':'Latest on GitHub'}</h2>
{latest.length ? <ul class="dated">{latest.map(i => <li><time datetime={i.date}>{fmt(i.date)}</time><span>{ja ? <><a href={i.url}>{i.repo}</a> の変更をマージ</> : <><a href={i.url}>{i.title}</a> <span class="mut">· {i.repo}</span></>}</span></li>)}</ul>
 : <p class="mut">{ja?'更新の一覧を読み込めませんでした。':'The list could not be loaded at build time.'}</p>}
<a href={C.github}>{ja?'GitHubで見る →':'All activity on GitHub →'}</a></div>
</section>

<section class="doors"><div class="grid3">
<div class="card door"><h3>{ja?'採用担当の方へ':'For recruiters'}</h3><p>{ja?'数字つきのプロジェクト、職務経歴、連絡先。':'Projects with measured results, work history and contact details.'}</p><p class="mut small">{ja?'就労ビザのスポンサーが必要です。':'Visa sponsorship needed.'}</p><a href="#work">{ja?'職務経歴 →':'Work history →'}</a></div>
<div class="card door warm"><h3>{ja?'これから挑戦する方へ':'For learners'}</h3><p>{ja?'インドから日本で働くまでの記録と、日本語の勉強。':'My path from India toward work in Japan, and how I study Japanese.'}</p><a href={`${B}/${lang}/now/`}>{ja?'いまの様子 →':'What I\'m doing now →'}</a><br><a href={`${B}/${lang}/talk/`}>{ja?'日本での就職について相談する →':'Book a 1:1 chat about Japan →'}</a></div>
<div class="card door"><h3>{ja?'エンジニアの方へ':'For engineers'}</h3><p>{ja?'評価の方法、テストの件数、コード。':'How each system was tested, with test sizes and code.'}</p><a href={`${B}/${lang}/projects/`}>{ja?'プロジェクト →':'Projects →'}</a><br><a href={C.github}>GitHub →</a></div>
</div></section>

<section class="narrow" id="work"><h2>{ja?'職務経歴':'Experience'}</h2><Experience lang={lang}/></section>

<section class="narrow" id="contact"><h2>{ja?'連絡先':'Say hello'}</h2>
<p class="crow"><a href={`mailto:${C.email}`}>{C.email}</a><a href={C.linkedin}>LinkedIn</a><a href={C.github}>GitHub</a><a href={C.topmate}>{ja?'1対1の相談（Topmate）':'1:1 chat (Topmate)'}</a></p></section>
</Base>
