---
import { SITE_NAME } from '../../config';
import Voices from '../../components/Voices.astro';
import Blob from '../../components/Blob.astro';
import Base from '../../layouts/Base.astro';
export { paths as getStaticPaths } from '../../data/paths';
import Contact from '../../components/Contact.astro'; import Avatar from '../../components/Avatar.astro';
import m from '../../data/metrics.json'; import latest from '../../data/latest.json';
import { CONTACT as C } from '../../config'; import FlashDeck from '../../components/FlashDeck.astro'; import Chomp from '../../components/Chomp.astro';
const { lang } = Astro.params; const ja = lang==='ja';
const _b = import.meta.env.BASE_URL; const B = _b.endsWith('/') ? _b.slice(0, -1) : _b;
const P = (s) => `${B}/${lang}/projects/${s}/`;
const fmt = (d) => { const [y,mo,da] = d.split('-').map(Number); return ja ? `${mo}月${da}日` : new Date(Date.UTC(y,mo-1,da)).toLocaleDateString('en-GB',{day:'numeric',month:'short',timeZone:'UTC'}); };
const nums = [
 { slug:'meeting-notes-to-crm', v:`${m.crm.attack_before} → ${m.crm.attack_after}`,
   en:['Attacks that got through (before → after)', `On ${m.crm.attacks} attacks I wrote myself`],
   ja:['攻撃が通った割合（対策の前→後）', `自作の攻撃${m.crm.attacks}件での結果`] },
 { slug:'japanese-document-search', v:m.rag.hit5,
   en:['Japanese search: right passage in top 5', `${m.rag.questions} questions on one government report`],
   ja:['文書検索で正解が上位5件に入った割合', `政府の報告書1冊、${m.rag.questions}問での結果`] },
 { slug:'credit-card-fraud', v:`${m.fraud.recall} / ${m.fraud.precision}`,
   en:['Fraud caught / alerts correct', `Public dataset where ${m.fraud.fraud_rate} of payments are fraud`],
   ja:['不正の検出率 / 警告の正しさ', `不正が${m.fraud.fraud_rate}しかない公開データでの結果`] },
];
const now = ja
 ? [['2026-10-31','毎日日本語を勉強しています。'],['2026-10-31','CRMプロジェクト：完成しました。READMEと測った数字があります。次の中心になるプロジェクトを探しています。'],['','このサイトを作っています。']]
 : [['2026-10-31','I study Japanese every day.'],['2026-10-31','CRM project: finished, with a README and measured numbers. Looking for the next anchor project.'],['','Building this site.']];
---
<style>.start{margin:.7rem 0 0;padding:.55rem .8rem;border:1px dashed var(--line);border-radius:12px;background:var(--card)}.startb{font:inherit;font-weight:700;min-height:44px;padding:0 .2rem;border:0;background:none;color:var(--acc);text-decoration:underline;cursor:pointer}.startb:focus-visible{outline:3px solid var(--acc);outline-offset:2px}</style>
<Base lang={lang} title={ja?'AI/MLエンジニア':'AI/ML engineer'}>
<nav class="rail" aria-label={ja?'このページの中':'On this page'}>{(ja?[['projects','プロジェクト'],['now','いま'],['contact','連絡先']]:[['projects','Projects'],['now','Now'],['contact','Say hello']]).map(([i,l]) => <a href={`#${i}`}>{l}</a>)}</nav>
<div class="hero4">
<Avatar size={112}/>
<div>
{ja ? <>
<p class="hi">こんにちは。</p>
<h1>{SITE_NAME}</h1>
<p class="title">AI/MLエンジニア。ソフトウェアの仕事は約4年、そのうち約2.5年はAIとLLMの仕事です。</p>
<p class="lead">仕事で使うAIを作り、テストしています。日本語の文書、AIの評価、セキュリティのテストです。</p>
<p class="start">ここはわたしのウェブ上の拠点です。仕事、プロジェクト、相談の案内をまとめています。どこから見ればいいか迷ったら、<button type="button" class="startb" data-guide-open>サイトガイド</button>をタップしてください。</p>
</> : <>
<p class="hi">Hello, I'm</p>
<h1>{SITE_NAME}</h1>
<p class="title">AI/ML engineer. About 4 years in software, the last 2.5 in AI and LLM work.</p>
<p class="lead">I build and test AI for real work: Japanese documents, evaluation and security testing.</p>
<p class="start"><span>This is my home on the web: my work, projects and guidance. Not sure where to start?</span> <button type="button" class="startb" data-guide-open>Tap Site guide</button></p>
{(lang==='fr'||lang==='ru') && <p class="small mut i18nnote">{lang==='fr'?'Ceci est une première traduction. Vos remarques sur le français sont les bienvenues.':'Это первый вариант перевода. Буду рад замечаниям по тексту.'}</p>}
</>}
</div></div>

<section id="projects" aria-labelledby="pj-h"><h2 id="pj-h">{ja?'プロジェクト：それぞれが示すこと':'Projects: what each one shows'}</h2><p class="mut">{ja?'どのプロジェクトも、わたしの仕事の進め方を示しています。テストのしかた、数字での確認、弱い点の見つけ方です。':'Each project shows how I work: how I test, how I measure, and how I find the weak spots.'}</p><FlashDeck lang={lang}/></section>
<p class="mut small">{ja?'どれも決まった条件でのテストの数字です。条件と弱い点は各プロジェクトのページに書いています。':'These numbers come from focused tests. Each project page explains the setup and the weak spots.'}</p>

<section class="split" id="now">
<div class="card"><h2>{ja?'いま':'Now'}</h2>
<p class="mut"><time datetime="2026-10-31">{ja?'2026年10月31日 更新':'Updated 31 Oct 2026'}</time></p>
<ul class="dated">{now.map(([d,t]) => <li>{d ? <time datetime={d}>{fmt(d)}</time> : <span></span>}<span>{t}</span></li>)}</ul>
<a href={`${B}/${lang}/now/`}>{ja?'くわしく →':'More on the Now page →'}</a></div>
<div class="card"><h2>{ja?'最近の更新（GitHub）':'Latest on GitHub'}</h2>
{latest.length ? <ul class="dated">{latest.map(i => <li><time datetime={i.date}>{fmt(i.date)}</time><span>{ja ? <><a href={i.url}>{i.repo}</a> の変更をマージ</> : <><a href={i.url} translate="no">{i.title}</a> <span class="mut">· {i.repo}</span></>}</span></li>)}</ul>
 : <p class="mut">{ja?'更新の一覧を読み込めませんでした。':'The list could not be loaded at build time.'}</p>}
<a href={C.github}>{ja?'GitHubで見る →':'All activity on GitHub →'}</a></div>
</section>

<section class="doors"><div class="grid2">
<div class="card door warm"><h3>{ja?'これから挑戦する方へ':'For learners'}</h3><p>{ja?'日本で働くまでの記録と、日本語の勉強。':'My path toward work in Japan, and how I study Japanese.'}</p><a class="btn ghost dbtn" href={`${B}/${lang}/now/`}>{ja?'いまの様子':'What I\'m doing now'}</a><a class="btn ghost dbtn" href={`${B}/${lang}/talk/`}>{ja?'日本での就職について相談する':'Book a 1:1 chat about Japan'}</a></div>
<div class="card door"><h3>{ja?'エンジニアの方へ':'For engineers'}</h3><p>{ja?'評価の方法、テストの件数、コード。':'How each system was tested, with test sizes and code.'}</p><a class="btn ghost dbtn" href={`${B}/${lang}/projects/`}>{ja?'プロジェクト':'Projects'}</a><a class="btn ghost dbtn" href={C.github}>GitHub</a></div>
</div></section>
<p class="reclink"><a href={`${B}/${lang==='ja'?'ja':'en'}/recruiter/?ref=home`}>{ja?'採用担当の方へ →':'For recruiters →'}</a></p>

<Voices lang={lang}/>
<div class="hrow">
<section class="card hstrip" aria-label={ja?'仕事の依頼':'Work with me'}><p>{ja?'AIの評価、AIのセキュリティテスト、AIを使ったツールやウェブサイトの制作をお受けしています。':'Available for AI evaluation, AI security testing and building AI-powered tools and websites.'}</p><a class="btn" href={`${B}/${lang}/work/`}>{ja?'仕事の依頼':'Work with me'}</a></section>
<section class="card hstrip" aria-label={ja?'わたしのエージェントチーム':'My team of agents'}><div class="mini"><a href={`${B}/${lang}/team/`}><span class="chw"><Blob fill="#F6CFD8" acc="study"/></span><span class="chw"><Blob fill="#D9E3F3" acc="github"/></span><span class="chw"><Blob fill="#FFF8EC" acc="site"/></span><span class="lk">{ja?'わたしのエージェントチーム →':'My team of agents →'}</span></a></div></section>
</div>

<div class="chompw"><Chomp/></div>
<section class="narrow" id="contact"><h2>{ja?'連絡先':'Say hello'}</h2>
<p>{ja?'メール、LinkedIn、GitHub、Topmateへのリンクは、どのページでもいちばん下にあります。':'My email, LinkedIn, GitHub and Topmate links are at the bottom of every page.'}</p></section>
</Base>
