---
import Base from '../../layouts/Base.astro';
export { paths as getStaticPaths } from '../../data/paths';
import { projects } from '../../data/projects'; import Card from '../../components/Card.astro';
import Contact from '../../components/Contact.astro'; import Experience from '../../components/Experience.astro'; import NowStrip from '../../components/NowStrip.astro';
import { showPortrait } from '../../config';
const { lang } = Astro.params; const ja = lang==='ja';
const _b = import.meta.env.BASE_URL; const B = _b.endsWith('/') ? _b.slice(0, -1) : _b;
---
<Base lang={lang} title={ja?'ホーム':'Home'}>
<div class="hero"><div>
{ja ? <>
<h1>プリティヴィ・ラージ・モハンタ</h1>
<p class="title">AI / MLエンジニア — LLMの評価、日本語AI、ゲーム開発</p>
<p class="lead">業務委託でLLMの回答を評価しています。個人では日本語の文書を扱う小さなAIツールを作り、テストの方法と結果を公開しています。</p>
</> : <>
<h1>Prithivi Raj Mohanta</h1>
<p class="title">AI / ML engineer — LLM evaluation, Japanese-language AI, game development</p>
<p class="lead">I evaluate large language model answers as a contractor, and I build small AI tools for Japanese text and publish how I tested them.</p>
</>}
</div>{showPortrait && <img src={`${B}/portrait.webp`} width="180" height="180" alt={ja?'プリティヴィ・ラージ・モハンタの顔写真':'Portrait of Prithivi Raj Mohanta'}>}</div>
<dl class="facts">
<div><dt>{ja?'拠点':'Based'}</dt><dd>{ja?'インド（オディシャ州）':'Odisha, India'}</dd></div>
<div><dt>{ja?'専門':'Focus'}</dt><dd>{ja?'LLMの評価、日本語AI':'LLM evaluation, Japanese-language AI'}</dd></div>
<div><dt>{ja?'日本語':'Japanese'}</dt><dd class="chip">{ja?'2026年12月6日 JLPT N2受験':'Taking JLPT N2 on Dec 6, 2026'}</dd></div>
<div><dt>{ja?'現在':'Currently'}</dt><dd>{ja?'日本企業の選考を受けています':'In the hiring process with Japanese companies'}</dd></div>
</dl>
<NowStrip lang={lang}/>
<section class="doors"><div class="grid3">
<div class="card door"><h3>{ja?'採用担当の方へ':'For recruiters'}</h3><p>{ja?'数字つきのプロジェクト、職務経歴、連絡先。':'Projects with measured results, work history and contact details.'}</p><p class="mut small">{ja?'就労ビザのスポンサーが必要です。':'Visa sponsorship needed.'}</p><a href="#contact">{ja?'プロジェクトと連絡先 →':'Projects and contact →'}</a></div>
<div class="card door warm"><h3>{ja?'これから挑戦する方へ':'For learners and followers'}</h3><p>{ja?'インドから日本で働くまでの記録と、日本語の勉強。':'My path from India to working in Japan, and how I study Japanese.'}</p><a href={`${B}/${lang}/now/`}>{ja?'いまの様子 →':'What I\'m doing now →'}</a><br><a href={`${B}/${lang}/advice/`} class="mut">{ja?'相談（Topmate）':'Advice calls (Topmate)'}</a></div>
<div class="card door"><h3>{ja?'エンジニアの方へ':'For engineers'}</h3><p>{ja?'評価の方法、テストの件数、コード。':'How each system was evaluated, with test sizes and code.'}</p><a href={`${B}/${lang}/projects/`}>{ja?'プロジェクト →':'Projects →'}</a><br><a href="https://github.com/Retro099">GitHub →</a></div>
</div></section>
<section><h2>{ja?'プロジェクト':'Projects'}</h2><div class="grid3">{projects.map(p => <Card p={p} lang={lang}/>)}</div></section>
<section class="narrow"><h2>{ja?'仕事の進め方':'How I work'}</h2>
{ja ? <ol><li>作る前に、何で成功を測るかを決めます。</li><li>数字には、テストの件数と弱いところを書きます。</li><li>一人で作っています。調査と下書きはAIエージェントが手伝い、最後の判断とチェックは私が行います。</li></ol>
 : <ol><li>I decide how success will be measured before I build anything.</li><li>Every number comes with its test size and its weak points.</li><li>I work alone with AI agents for research and drafts; final decisions and checks are mine.</li></ol>}
</section>
<section class="narrow"><h2>{ja?'職務経歴':'Experience'}</h2><Experience lang={lang}/></section>
<section class="narrow"><Contact lang={lang}/></section>
</Base>
