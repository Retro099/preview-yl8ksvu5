---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro'; import TeamDeck from '../../components/TeamDeck.astro';
import { timeline } from '../../data/team';
export { paths as getStaticPaths } from '../../data/paths';
const { lang } = Astro.params; const ja = lang==='ja';
const T = ja ? {
 title:'わたしのエージェントチーム', eb:'仕事の進め方', line:'すべて自分で決めて、ぜんぶ自分で確認しています。',
 hist:'このサイトの作り方', histNote:'git のタグと記録から作った、本当の更新の記録です。時間はすべてインド時間（IST）です。',
 facts:'最初のコミット：2026年10月25日 14:22（IST）。v4.10：2026年10月25日 23:27（IST）。', now:'この版',
 doH:'エージェントがすること', doL:['調べものと出典さがし','書類の下書き','勉強とまちがいの記録','コードを作ってテストする'],
 meH:'わたしがすること', meL:['決める','すべての内容を確認する','送るものは、すべて自分で送る'],
} : {
 title:'My team of agents', eb:'How I work', line:'I decide and check everything myself.',
 hist:'How this site was built', histNote:'A real version history, taken from the git tags and commits. All times are IST.',
 facts:'First commit: 25 Oct 2026, 14:22 IST. v4.10: 25 Oct 2026, 23:27 IST.', now:'this version',
 doH:'What agents do here', doL:['Research and sourcing','Drafting documents','Tracking study and mistakes','Building and testing code'],
 meH:'What I do', meL:['Decide','Check every claim','Send everything myself'],
};
---
<Base lang={lang} page="team" title={T.title} description={T.line}>
<PageHead eyebrow={T.eb} title={T.title} intro={T.line}/>
<section aria-label={T.title}><TeamDeck lang={lang}/></section>
<section class="roles">
<div class="card"><h2>{T.doH}</h2><ul>{T.doL.map(x => <li>{x}</li>)}</ul></div>
<div class="card warm"><h2>{T.meH}</h2><ul>{T.meL.map(x => <li>{x}</li>)}</ul></div>
</section>
<section id="history" class="hist"><h2>{T.hist}</h2>
<p class="mut">{T.histNote}</p>
<ol class="tl">{timeline.map(([v,t,en,jp]) => <li><span class="tv">{v}</span><span class="tt">{t ? <time datetime={`2026-10-25T${t}+05:30`}>{ja?`10月25日 ${t}`:`25 Oct, ${t}`}</time> : <span>{ja?`10月25日（${T.now}）`:`25 Oct (${T.now})`}</span>}</span><span>{ja?jp:en}</span></li>)}</ol>
<p class="small mut">{T.facts}</p>
</section>
</Base>
