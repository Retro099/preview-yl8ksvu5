---
// Team flip cards. Same pattern and script as FlashDeck (.deck/.fc/.face, .fx added by JS).
import Blob from './Blob.astro';
import { team } from '../data/team';
const { lang } = Astro.props; const ja = lang==='ja';
---
<div class="deckw">
<p class="hint mut small" aria-hidden="true">{ja?'← 左右にスワイプ · タップで裏返す →':'← Swipe · tap a card to flip →'}</p>
<div class="agbar"><span class="adot" aria-hidden="true"></span><strong>{ja?'エージェントボード':'Agent board'}</strong><span class="mut small">{ja?'たのんだときに動きます。結果はすべて自分で確認します。':'Ready when I ask. I review every result.'}</span></div>
<div class="deck team" data-deck>
{team.map(m => { const t = ja ? m.ja : m.en; return (
<div class="fc tm" data-agent={m.id}>
<div class="fc-in">
<button type="button" class="face front" aria-pressed="false" aria-label={ja?`${t.name}（${t.job}）：カードを裏返して説明を見る`:`${t.name}, ${t.job}: flip card for details`}>
<span class="arole"><i class="adot" aria-hidden="true"></i>{t.role}</span><span class="chw"><Blob fill={m.fill} acc={m.acc}/></span>
<span class="fname">{t.name}</span><span class="fjob small">{t.job}</span><svg class="spk-i" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"/><path d="M16 8.5q2 3.5 0 7M18.5 6q3.5 6 0 12" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>
<span class="flip mut small" aria-hidden="true">{ja?'タップで裏返す ↻':'Tap to flip ↻'}</span>
</button>
<div class="face back">
<p class="bt">{t.name}</p>
<p lang={ja?'ja':'en'}>{t.intro}</p>
<p class="bt">{ja?'実際にしたこと':'One real thing'}</p>
{t.real ? <p class="lim">{t.real}</p> : <p class="lim"><a href="#history">{ja?'下の「このサイトの作り方」を見てください':'See the version history below'}</a></p>}
<button type="button" class="unflip" aria-pressed="true" aria-label={ja?`${t.name}：表にもどす`:`${t.name}: flip back to front`}>{ja?'↺ 表にもどす':'↺ Front'}</button>
</div>
</div></div>)})}
</div>
<p class="dots" aria-hidden="true">{team.map((_,i) => <span class={i===0?'on':''}></span>)}</p>
</div>
<script is:inline>
(()=>{document.querySelectorAll('[data-deck]:not(.fx)').forEach(d=>{d.classList.add('fx');const cards=[...d.querySelectorAll('.fc')];
cards.forEach(c=>{const f=c.querySelector('.front'),b=c.querySelector('.back'),u=c.querySelector('.unflip');b.inert=true;
const set=(on)=>{c.classList.toggle('on',on);f.setAttribute('aria-pressed',on);f.inert=on;b.inert=!on;(on?u:f).focus({preventScroll:true});};
f.addEventListener('click',()=>set(true));u.addEventListener('click',()=>set(false));});
const dots=[...d.parentNode.querySelectorAll('.dots span')];
if('IntersectionObserver' in window){const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.intersectionRatio>.6){const i=cards.indexOf(e.target);dots.forEach((s,j)=>s.classList.toggle('on',i===j));}}),{root:d,threshold:[.6]});cards.forEach(c=>io.observe(c));}});})();
</script>
<style>.agbar{display:flex;flex-wrap:wrap;align-items:center;gap:.35rem .6rem;margin:0 0 .7rem;padding:.55rem .8rem;border:1px solid var(--line);border-radius:12px;background:var(--card);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.85rem}
.adot{display:inline-block;width:8px;height:8px;border-radius:50%;background:#3FA66B;box-shadow:0 0 0 3px color-mix(in srgb,#3FA66B 25%,transparent);flex:none}
@media (prefers-reduced-motion:no-preference){.agbar .adot{animation:apulse 2.4s ease-in-out infinite}}@keyframes apulse{50%{box-shadow:0 0 0 6px color-mix(in srgb,#3FA66B 8%,transparent)}}
.arole{display:inline-flex;align-items:center;gap:.35rem;align-self:flex-start;font:600 .7rem/1 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.03em;text-transform:uppercase;padding:.25rem .5rem;border-radius:999px;border:1px solid var(--line);color:var(--acc);background:color-mix(in srgb,var(--acc) 8%,var(--card))}
.arole .adot{width:6px;height:6px;box-shadow:none}
.deck.team .front{border:1px solid var(--line);border-bottom:3px solid var(--acc);border-radius:14px;box-shadow:0 4px 14px rgba(20,30,50,.07);background-image:linear-gradient(color-mix(in srgb,var(--acc) 5%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--acc) 5%,transparent) 1px,transparent 1px);background-size:14px 14px}
.fjob{display:block;color:var(--fg);max-width:22ch;line-height:1.3}.deck.team{align-items:start}.deck.team .fc-in>.face{grid-area:auto;transform:none!important;height:auto!important;min-height:0!important}.deck.team .fc:not(.on) .back,.deck.team .fc.on .front{display:none}.deck.team .front{padding:.8rem .8rem .7rem;gap:.35rem!important}.deck.team .front .chw{width:84px!important;height:78px!important}.deck.team .flip{margin-top:.2rem!important}.deck.team .back{padding:.8rem}
.spk-i{position:absolute;top:.6rem;right:.6rem;color:var(--acc);opacity:.8}.fc .front{position:relative}</style>
<script is:inline>
// v6.2: tap an agent card = short cute nonsense babble (synthesised, no words, no speech). Only on tap, only if Sound is on.
(()=>{let ctx=null,rv=null;const W=window.AudioContext||window.webkitAudioContext;if(!W)return;
const P={study:[520,1],docs:[440,2],github:[380,3],programs:[600,4],overseas:[480,5],topmate:[660,6],site:[560,7]};
const rnd=s=>()=>(s=(s*16807)%2147483647)/2147483647;
const bus=c=>{if(rv)return rv;const out=c.createGain();out.gain.value=.9;const d=c.createDelay(),fb=c.createGain(),wet=c.createGain(),lp=c.createBiquadFilter();d.delayTime.value=.09;fb.gain.value=.28;wet.gain.value=.22;lp.type='lowpass';lp.frequency.value=2600;
out.connect(c.destination);out.connect(d);d.connect(lp).connect(fb).connect(d);lp.connect(wet).connect(c.destination);return rv=out};
const babble=id=>{const [f0,seed]=P[id]||[500,9];try{ctx=ctx||new W();if(ctx.state==='suspended')ctx.resume()}catch(e){return}
const c=ctx,o=bus(c),r=rnd(seed*7919+Math.floor(Date.now()/700)%5);let t=c.currentTime+.02;const n=3+Math.floor(r()*3);
for(let k=0;k<n;k++){const d=.09+r()*.07,f=f0*(0.85+r()*.5),up=r()>.4;
 const a=c.createOscillator(),b=c.createOscillator(),lfo=c.createOscillator(),lg=c.createGain(),bp=c.createBiquadFilter(),g=c.createGain();
 a.type='sine';b.type='triangle';a.frequency.setValueAtTime(f*(up?.8:1.25),t);a.frequency.exponentialRampToValueAtTime(f*(up?1.3:.85),t+d);
 b.frequency.setValueAtTime(f*2*(up?.8:1.25),t);b.frequency.exponentialRampToValueAtTime(f*2*(up?1.3:.85),t+d);
 lfo.frequency.value=22+r()*10;lg.gain.value=f*.04;lfo.connect(lg);lg.connect(a.frequency);lg.connect(b.frequency);
 bp.type='bandpass';bp.Q.value=3;bp.frequency.setValueAtTime(700+r()*500,t);bp.frequency.linearRampToValueAtTime(1400+r()*900,t+d);
 const bg=c.createGain();bg.gain.value=.35;b.connect(bp).connect(bg).connect(g);a.connect(g);
 g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(.2,t+.015);g.gain.setValueAtTime(.2,t+d*.6);g.gain.exponentialRampToValueAtTime(.001,t+d);g.connect(o);
 [a,b,lfo].forEach(x=>{x.start(t);x.stop(t+d+.02)});t+=d+.025+r()*.04}};
document.querySelectorAll('.deck.team .front').forEach(f=>f.addEventListener('click',()=>{let off=false;try{off=localStorage.getItem('sound')==='off'}catch(e){}if(off)return;babble(f.closest('[data-agent]')?.dataset.agent)}));})();
</script>
