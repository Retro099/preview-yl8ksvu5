---
// Team flip cards. Same pattern and script as FlashDeck (.deck/.fc/.face, .fx added by JS).
import Blob from './Blob.astro';
import { team } from '../data/team';
const { lang } = Astro.props; const ja = lang==='ja';
---
<div class="deckw">
<p class="hint mut small" aria-hidden="true">{ja?'← 左右にスワイプ · タップで裏返す →':'← Swipe · tap a card to flip →'}</p>
<div class="deck team" data-deck>
{team.map(m => { const t = ja ? m.ja : m.en; return (
<div class="fc tm">
<div class="fc-in">
<button type="button" class="face front" aria-pressed="false" aria-label={ja?`${t.role}：カードを裏返して説明を見る`:`${t.role} agent: flip card for details`}>
<span class="chw"><Blob fill={m.fill} acc={m.acc}/></span>
<span class="fname">{t.role}</span><svg class="spk-i" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"/><path d="M16 8.5q2 3.5 0 7M18.5 6q3.5 6 0 12" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>
<span class="flip mut small" aria-hidden="true">{ja?'タップで裏返す ↻':'Tap to flip ↻'}</span>
</button>
<div class="face back">
<p class="bt">{t.role}</p>
<p lang={ja?'ja':'en'}>{t.intro}</p>
<p class="bt">{ja?'実際にしたこと':'One real thing'}</p>
{t.real ? <p class="lim">{t.real}</p> : <p class="lim"><a href="#history">{ja?'下の「このサイトの作り方」を見てください':'See the version history below'}</a></p>}
<button type="button" class="unflip" aria-pressed="true" aria-label={ja?`${t.role}：表にもどす`:`${t.role}: flip back to front`}>{ja?'↺ 表にもどす':'↺ Front'}</button>
</div>
</div></div>)})}
</div>
<p class="dots" aria-hidden="true">{team.map((_,i) => <span class={i===0?'on':''}></span>)}</p>
</div>
<script is:inline>
(()=>{document.querySelectorAll('[data-deck]:not(.fx)').forEach(d=>{d.classList.add('fx');const cards=[...d.querySelectorAll('.fc')];
cards.forEach(c=>{const f=c.querySelector('.front'),b=c.querySelector('.back'),u=c.querySelector('.unflip');b.inert=true;
const set=(on)=>{c.classList.toggle('on',on);f.setAttribute('aria-pressed',on);f.inert=on;b.inert=!on;(on?u:f).focus({preventScroll:true});};
f.addEventListener('click',()=>set(true));u.addEventListener('click',()=>set(false));});
const dots=[...d.parentNode.querySelectorAll('.dots span')];
if('IntersectionObserver' in window){const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.intersectionRatio>.6){const i=cards.indexOf(e.target);dots.forEach((s,j)=>s.classList.toggle('on',i===j));}}),{root:d,threshold:[.6]});cards.forEach(c=>io.observe(c));}});})();
</script>
<style>.spk-i{position:absolute;top:.6rem;right:.6rem;color:var(--acc);opacity:.8}.fc .front{position:relative}</style>
<script is:inline>
// v6.1: tap an agent card to hear its displayed name (browser speech). Only if Sound is on; silent if no voice.
(()=>{const S=window.speechSynthesis;if(!S||!window.SpeechSynthesisUtterance)return;const lg=document.documentElement.lang||'en',M={en:'en-US',ja:'ja-JP',fr:'fr-FR',ru:'ru-RU'};
let V=S.getVoices();S.addEventListener&&S.addEventListener('voiceschanged',()=>{V=S.getVoices()});
document.querySelectorAll('.deck.team .front').forEach(f=>f.addEventListener('click',()=>{let off=false;try{off=localStorage.getItem('sound')==='off'}catch(e){}if(off)return;
V=V.length?V:S.getVoices();if(!V.length)return;const n=f.querySelector('.fname');if(!n)return;S.cancel();const u=new SpeechSynthesisUtterance(n.textContent.trim());u.lang=M[lg]||lg;
const v=V.find(x=>x.lang&&x.lang.toLowerCase().startsWith(lg));if(v)u.voice=v;S.speak(u)}));})();
</script>
