---
// Soft cream blob character. Decorative (aria-hidden). Static without JS or with reduced motion.
const { size = 112, mark = false } = Astro.props;
const BLOB = "M31 52C26 36 43 24 57 30C65 18 88 21 90 39C101 43 104 60 100 72C100 92 84 104 60 104C36 104 18 92 20 72C18 63 22 56 31 52Z";
const S = 'fill="#FFF8EC" stroke="#2B4C7E" stroke-width="3.2" stroke-linejoin="round" stroke-linecap="round"';
---
{mark ? (
<svg class="mark" width="32" height="32" viewBox="14 14 92 96" aria-hidden="true" focusable="false">
<path d={BLOB} fill="#FFF8EC" stroke="#2B4C7E" stroke-width="5" stroke-linejoin="round"/>
<ellipse cx="48" cy="70" rx="5" ry="3.4" fill="#1E2A3A"/><ellipse cx="72" cy="70" rx="5" ry="3.4" fill="#1E2A3A"/>
<circle cx="38" cy="80" r="5" fill="#C8553D" opacity=".4"/><circle cx="82" cy="80" r="5" fill="#C8553D" opacity=".4"/>
</svg>
) : (
<div class="av" style={`width:${size}px;height:${size}px`}>
<svg id="av" viewBox="0 0 120 120" width={size} height={size} aria-hidden="true" focusable="false">
<ellipse id="av-shadow" cx="60" cy="110" rx="34" ry="5" fill="#2B4C7E" opacity=".14"/>
<g id="av-char">
<g class="sh" data-s="blob" data-f="0 0 1"><path d={BLOB} fill="#FFF8EC" stroke="#2B4C7E" stroke-width="3.2" stroke-linejoin="round"/><path d="M34 60C34 50 40 44 47 42" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" opacity=".9"/></g>
<g class="sh" data-s="plane" data-f="2 -6 .8" style="display:none"><g set:html={`<path d="M12 66L108 34L66 100L54 76Z" ${S}/><path d="M108 34L54 76L48 92L60 80" ${S}/>`}/></g>
<g class="sh" data-s="book" data-f="0 2 .95" style="display:none"><g set:html={`<path d="M60 48Q40 34 16 44V96Q40 86 60 98Z" ${S}/><path d="M60 48Q80 34 104 44V96Q80 86 60 98Z" ${S}/><path d="M24 54Q40 48 52 56M68 56Q80 48 96 54" fill="none" stroke="#2B4C7E" stroke-width="1.6" opacity=".35"/>`}/></g>
<g class="sh" data-s="torii" data-f="0 -31 .62" style="display:none"><g set:html={`<path d="M34 48H44V104H34ZM76 48H86V104H76Z" ${S}/><path d="M26 58H94V66H26Z" ${S}/><path d="M10 30Q60 18 110 30L106 48Q60 40 14 48Z" ${S}/>`}/></g>
<g id="av-face">
<g id="av-eyes"><ellipse cx="48" cy="70" rx="4.6" ry="5.6" fill="#1E2A3A"/><ellipse cx="72" cy="70" rx="4.6" ry="5.6" fill="#1E2A3A"/><circle cx="49.6" cy="68" r="1.4" fill="#fff"/><circle cx="73.6" cy="68" r="1.4" fill="#fff"/></g>
<g id="av-lids"><path d="M41 62H55V67Q48 64 41 67Z" fill="#FFF8EC"/><path d="M65 62H79V67Q72 64 65 67Z" fill="#FFF8EC"/><path d="M43 66.4Q48 63.8 53 66.4M67 66.4Q72 63.8 77 66.4" fill="none" stroke="#2B4C7E" stroke-width="2" stroke-linecap="round"/></g>
<path id="av-mouth" d="M55.5 79.5Q60 84 64.5 79.5" fill="none" stroke="#2B4C7E" stroke-width="2.4" stroke-linecap="round"/>
<circle cx="38" cy="79" r="4.5" fill="#C8553D" opacity=".32"/><circle cx="82" cy="79" r="4.5" fill="#C8553D" opacity=".32"/>
</g>
</g>
</svg>
</div>
)}
{!mark && <script is:inline>
(()=>{const s=document.getElementById('av');if(!s)return;
const rm=matchMedia('(prefers-reduced-motion: reduce)').matches,$=q=>s.querySelector(q);
const ch=$('#av-char'),eyes=$('#av-eyes'),lids=$('#av-lids'),face=$('#av-face'),shadow=$('#av-shadow'),shapes=[...s.querySelectorAll('.sh')];
const story=['plane','book','torii'];let si=0,cur='blob',busy=false,back=0;
function show(n){cur=n;shapes.forEach(g=>{const on=g.dataset.s===n;g.style.display=on?'':'none';if(on){const[x,y,k]=g.dataset.f.split(' ').map(Number);face.setAttribute('transform',`translate(${60+x} ${70+y}) scale(${k}) translate(-60 -70)`)}})}
let squ=0;
function morph(n){if(rm){show(n);return}if(busy)return;busy=true;squ=1;setTimeout(()=>{show(n);setTimeout(()=>{squ=0;busy=false},60)},260)}
s.parentNode.addEventListener('click',()=>{const n=cur==='blob'?story[si++%3]:'blob';if(rm){show(n);return}if(busy)return;clearTimeout(back);morph(n);if(n!=='blob')back=setTimeout(()=>morph('blob'),2600)});
s.parentNode.style.cursor='pointer';if(rm)return;
let tx=0,ty=0,ux=0,uy=0,last=-1e9,lid=0,blinkAt=performance.now()+2000,sighAt=performance.now()+9000,sq=0;
const mv=e=>{const r=s.getBoundingClientRect(),dx=e.clientX-(r.left+r.width/2),dy=e.clientY-(r.top+r.height*.58),d=Math.hypot(dx,dy)||1,k=Math.min(1,d/260);tx=dx/d*k;ty=dy/d*k;last=performance.now()};
addEventListener('pointermove',mv,{passive:true});addEventListener('pointerdown',mv,{passive:true});
function f(t){if(t-last>4000){tx=Math.sin(t/2600)*.6;ty=Math.sin(t/3700)*.3}
ux+=(tx-ux)*.06;uy+=(ty-uy)*.06;sq+=(squ-sq)*.18;
let lidT=0;if(t>blinkAt){lidT=1;if(t>blinkAt+220)blinkAt=t+3000+Math.random()*4000}
let sigh=0,sp=(t-sighAt)/2200;if(sp>0&&sp<1){sigh=Math.sin(sp*Math.PI)}else if(sp>=1)sighAt=t+14000+Math.random()*8000;
lid+=((lidT?1:sigh*.45)-lid)*.25;
const br=Math.sin(t/1400)*.018,shrug=sp>0&&sp<1?Math.sin(sp*Math.PI*2)*.05:0;
const sy=1+br-sq*.38+shrug+uy*-.03,sx=1-br*.6+sq*.25-shrug*.5+Math.abs(ux)*.04;
ch.setAttribute('transform',`translate(60 106) skewX(${(ux*-9).toFixed(2)}) rotate(${(ux*5).toFixed(2)}) scale(${sx.toFixed(3)} ${sy.toFixed(3)}) translate(-60 -106) translate(${(ux*3).toFixed(2)} 0)`);
eyes.setAttribute('transform',`translate(${(ux*3.2).toFixed(2)} ${(uy*2.2).toFixed(2)})`);
lids.setAttribute('transform',`translate(0 62) scale(1 ${(1+lid*2.6).toFixed(3)}) translate(0 -62)`);
shadow.setAttribute('rx',(34*sx).toFixed(1));requestAnimationFrame(f)}
requestAnimationFrame(f)})();
</script>}
