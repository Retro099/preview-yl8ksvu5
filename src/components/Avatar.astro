---
// Hand-drawn SVG character. Decorative (aria-hidden). Static without JS or with reduced motion.
const { size = 160, mark = false } = Astro.props;
---
{mark ? (
<svg class="mark" width="28" height="28" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
<circle cx="60" cy="60" r="58" fill="#2B4C7E"/><rect x="30" y="34" width="60" height="54" rx="24" fill="#FAFAF7"/>
<circle cx="47" cy="60" r="9" fill="none" stroke="#C8553D" stroke-width="4"/><circle cx="73" cy="60" r="9" fill="none" stroke="#C8553D" stroke-width="4"/>
<circle cx="47" cy="60" r="3.5" fill="#1B1F23"/><circle cx="73" cy="60" r="3.5" fill="#1B1F23"/>
</svg>
) : (
<div class="av" style={`width:${size}px;height:${size}px`}>
<svg id="av" viewBox="0 0 120 120" width={size} height={size} aria-hidden="true" focusable="false">
<circle cx="60" cy="60" r="58" fill="var(--soft)"/>
<g id="av-body"><path d="M24 120c0-24 16-36 36-36s36 12 36 36z" fill="#2B4C7E"/><path d="M52 86l8 10 8-10" fill="none" stroke="#FAFAF7" stroke-width="3" stroke-linecap="round"/></g>
<g id="av-head">
<line x1="60" y1="20" x2="60" y2="10" stroke="#2B4C7E" stroke-width="3"/><circle cx="60" cy="9" r="4.5" fill="#C8553D"/>
<rect x="28" y="20" width="64" height="62" rx="26" fill="#FAFAF7" stroke="#2B4C7E" stroke-width="3"/>
<g id="av-eyes">
<circle cx="46" cy="50" r="11" fill="#fff" stroke="#C8553D" stroke-width="3.5"/><circle cx="74" cy="50" r="11" fill="#fff" stroke="#C8553D" stroke-width="3.5"/>
<line x1="57" y1="50" x2="63" y2="50" stroke="#C8553D" stroke-width="3.5"/>
<g id="av-pupils"><circle cx="46" cy="50" r="4.2" fill="#1B1F23"/><circle cx="74" cy="50" r="4.2" fill="#1B1F23"/><circle cx="47.5" cy="48.5" r="1.3" fill="#fff"/><circle cx="75.5" cy="48.5" r="1.3" fill="#fff"/></g>
<g id="av-lids" fill="#FAFAF7" opacity="0"><circle cx="46" cy="50" r="9.4"/><circle cx="74" cy="50" r="9.4"/><path d="M38 51q8 4 16 0M66 51q8 4 16 0" stroke="#1B1F23" stroke-width="2" fill="none"/></g>
</g>
<path id="av-mouth" d="M51 68q9 7 18 0" fill="none" stroke="#2B4C7E" stroke-width="3" stroke-linecap="round"/>
<circle cx="36" cy="66" r="4" fill="#C8553D" opacity=".25"/><circle cx="84" cy="66" r="4" fill="#C8553D" opacity=".25"/>
</g>
</svg>
</div>
)}
{!mark && <script is:inline>
(()=>{const s=document.getElementById('av');if(!s||matchMedia('(prefers-reduced-motion: reduce)').matches)return;
const p=s.querySelector('#av-pupils'),h=s.querySelector('#av-head'),b=s.querySelector('#av-body'),l=s.querySelector('#av-lids');
let t=0,last=Date.now();
function look(x,y){const r=s.getBoundingClientRect(),dx=x-(r.left+r.width/2),dy=y-(r.top+r.height*.42),d=Math.hypot(dx,dy)||1,k=Math.min(1,d/300);
const ux=dx/d*k,uy=dy/d*k;p.setAttribute('transform',`translate(${(ux*5).toFixed(2)} ${(uy*4).toFixed(2)})`);
h.setAttribute('transform',`rotate(${(ux*7).toFixed(2)} 60 82) translate(${(ux*2).toFixed(2)} ${(uy*1.5).toFixed(2)})`);
b.setAttribute('transform',`translate(60 120) scale(${(1+Math.abs(ux)*.04).toFixed(3)} ${(1-Math.abs(ux)*.03+uy*.02).toFixed(3)}) skewX(${(ux*-4).toFixed(2)}) translate(-60 -120)`);}
const mv=e=>{last=Date.now();look(e.clientX,e.clientY)};
addEventListener('pointermove',mv,{passive:true});addEventListener('pointerdown',mv,{passive:true});
function blink(){l.setAttribute('opacity','1');setTimeout(()=>l.setAttribute('opacity','0'),140);setTimeout(blink,2500+Math.random()*3500)}
setTimeout(blink,1800);
setInterval(()=>{if(Date.now()-last<4000)return;t+=.05;const r=s.getBoundingClientRect();look(r.left+r.width/2+Math.sin(t)*160,r.top+r.height/2+Math.sin(t*.7)*60)},50);
})();
</script>}
