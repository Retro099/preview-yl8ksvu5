---
// Friend character. stages=true draws 5 life stages (a-e) as overlays; JS shows one at a time (.st-N on the svg).
const { hair='#1d1a1c', top='#E9A3B0', prop='drum', cls='', stages=false } = Astro.props;

---
<svg class={`fav ${cls} ${stages?'stgs st-0':''}`} viewBox="0 0 100 110" aria-hidden="true" focusable="false">
<path d="M27 44Q25 17 50 15Q75 17 73 44L75 74Q63 80 50 78Q37 80 25 74Z" fill={hair}/>
<rect x="45" y="58" width="10" height="10" fill="#F2CDB6"/>
<path d="M36 70Q50 63 64 70L68 104H32Z" fill={top}/>
<ellipse cx="50" cy="43" rx="17" ry="19" fill="#F6D9C6"/>
<path d="M32 40Q34 21 50 21Q66 21 68 40Q60 31 52 33Q43 29 32 40Z" fill={hair}/>
<ellipse cx="43" cy="46" rx="2.2" ry="3" fill="#2a2228"/><ellipse cx="57" cy="46" rx="2.2" ry="3" fill="#2a2228"/>
<circle cx="39" cy="52" r="3.2" fill="#E9A3B0" opacity=".7"/><circle cx="61" cy="52" r="3.2" fill="#E9A3B0" opacity=".7"/>
<path d="M46 54Q50 57 54 54" stroke="#9a4a4a" stroke-width="1.6" fill="none" stroke-linecap="round"/>
{(stages||prop==='drum') && <g class={stages?'stg s0':undefined}>
 <rect x="29" y="90" width="42" height="16" rx="3" fill="#D9A441"/><path d="M29 94H71M29 102H71" stroke="#B84C35" stroke-width="1.5"/>
 <ellipse class="fav-head" cx="50" cy="90" rx="21" ry="5" fill="#FFF8EC" stroke="#8a5a2b" stroke-width="1.2"/>
 <g class="stk stk-l"><line x1="35" y1="76" x2="46" y2="88" stroke="#8a5a2b" stroke-width="3" stroke-linecap="round"/><circle cx="35" cy="76" r="3.4" fill="#F6D9C6"/></g>
 <g class="stk stk-r"><line x1="65" y1="76" x2="54" y2="88" stroke="#8a5a2b" stroke-width="3" stroke-linecap="round"/><circle cx="65" cy="76" r="3.4" fill="#F6D9C6"/></g>
</g>}
{stages && <>
<g class="stg s1"><path d="M30 21L50 13L70 21L50 29Z" fill="#2B2F36"/><rect x="42" y="23" width="16" height="5" fill="#2B2F36"/><path d="M68 21V31" stroke="#D9A441" stroke-width="1.5"/><circle cx="68" cy="32" r="2" fill="#D9A441"/>
 <rect x="37" y="80" width="26" height="20" rx="2" fill="#2B4C7E"/><path d="M50 83V96M43 86H57M43 86L40.5 91H45.5ZM57 86L54.5 91H59.5ZM46 96H54" stroke="#E3B85C" fill="none" stroke-width="1.2" stroke-linejoin="round"/></g>
<g class="stg s2"><rect x="43" y="78" width="15" height="24" rx="3" fill="#2B2F36"/><rect x="45" y="81" width="11" height="17" rx="1" fill="#BFD6F2"/>
 <rect x="70" y="16" width="26" height="14" rx="7" fill="#FFF8EC" stroke="#2B4C7E" stroke-width="1.2"/><circle cx="77" cy="23" r="1.4" fill="#2B4C7E"/><circle cx="83" cy="23" r="1.4" fill="#2B4C7E"/><circle cx="89" cy="23" r="1.4" fill="#2B4C7E"/>
 <rect x="4" y="28" width="22" height="12" rx="6" fill="#E9A3B0"/><path d="M84 40c-1.5-2.5-5.5-1-3.5 2l3.5 3.5 3.5-3.5c2-3-2-4.5-3.5-2z" fill="#C8553D"/></g>
<g class="stg s3"><rect x="1" y="64" width="34" height="26" rx="3" fill="#3E5F3A" stroke="#8a5a2b" stroke-width="2"/><path d="M6 74q4-3 8 0t8 0M6 82h16M24 74l5 0" stroke="#FFF8EC" stroke-width="1.6" fill="none" stroke-linecap="round"/>
 <line x1="42" y1="90" x2="27" y2="76" stroke="#8a5a2b" stroke-width="2.2" stroke-linecap="round"/><circle cx="42" cy="90" r="3.2" fill="#F6D9C6"/></g>
<g class="stg s4"><rect x="4" y="94" width="20" height="11" rx="2" fill="#D9A441"/><ellipse cx="14" cy="94" rx="10" ry="2.6" fill="#FFF8EC" stroke="#8a5a2b"/>
 <path d="M70 98q-6-3-5-10" stroke="#E3B88A" stroke-width="3" fill="none" stroke-linecap="round"/><ellipse cx="81" cy="99" rx="12" ry="7" fill="#E3B88A"/><circle cx="88" cy="88" r="7.5" fill="#E3B88A"/>
 <path d="M82.5 84l-3-6.5 6 3zM93.5 84l3-6.5-6 3z" fill="#A9774A"/><circle cx="85.5" cy="88" r="1.1" fill="#2a2228"/><circle cx="90.5" cy="88" r="1.1" fill="#2a2228"/><ellipse cx="88" cy="91.2" rx="1.5" ry="1" fill="#2a2228"/></g>
</>}
</svg>
