---
// v6.1 scripted site guide (not an AI chat). Uses Prithivi's blob avatar. Dismiss with × (localStorage 'guide'='off'); reopen from "Site guide" in the nav or footer.
import Avatar from './Avatar.astro';
const { lang } = Astro.props;
const T:any = {
 en:{th:'Want a tour of the site?',need:'Want a quick tour?',open:'Open the site guide',how:'Want a quick tour?',tour:'Tour of the site',proj:'Projects',contact:'Contact',x:'Close the guide',next:'Next',back:'Back',end:'End',
  s:['This is Home. It shows my latest projects and what I am doing now.','Projects: each one shows what I built and how I tested it.','About: who I am and how I got into AI.','Work with me: small paid projects and how they work.','Talk: 1:1 chats and guides on Topmate.','Team: Pip, Sora and the other AI tools that help me. I decide and check everything.','The train carries comments from Japanese friends. Tap a window to read one.'],away:'On Home, a little train carries comments from Japanese friends.'},
 ja:{th:'サイトを案内しましょうか？',need:'かんたんに案内しましょうか？',open:'サイトの案内を開く',how:'かんたんに案内しましょうか？',tour:'サイトの案内',proj:'プロジェクト',contact:'連絡する',x:'案内を閉じる',next:'次へ',back:'戻る',end:'終わる',
  s:['ここがホームです。最新のプロジェクトと、いまの活動をのせています。','プロジェクト：作ったものと、そのテスト方法をのせています。','自己紹介：わたしのことと、AIの仕事を始めたきっかけです。','依頼：小さな有料プロジェクトと、その進め方です。','相談：Topmateでの1対1の相談とガイドです。','チーム：ピップやそらなど、わたしを手伝うAIツールです。決めるのも確認するのも、わたしです。','電車には日本の友だちのコメントがのっています。窓をタップすると読めます。'],away:'ホームでは、小さな電車が日本の友だちのコメントを運んでいます。'},
 fr:{th:'Une visite du site ?',need:'Une visite rapide ?',open:'Ouvrir le guide du site',how:'Une visite rapide ?',tour:'Visite du site',proj:'Projets',contact:'Contact',x:'Fermer le guide',next:'Suivant',back:'Retour',end:'Terminer',
  s:['Voici l’accueil. Il montre mes derniers projets et ce que je fais en ce moment.','Projets : chaque projet montre ce que j’ai construit et comment je l’ai testé.','À propos : qui je suis et comment je suis arrivé à l’IA.','Travailler avec moi : de petits projets payants, et comment ça se passe.','Parler avec moi : des échanges et des guides sur Topmate.','Équipe : Pip, Sora et les autres outils d’IA qui m’aident. Je décide et je vérifie tout.','Le train transporte les commentaires d’amies japonaises. Touchez une fenêtre pour en lire un.'],away:'Sur l’accueil, un petit train transporte les commentaires d’amies japonaises.'},
 ru:{th:'Хотите экскурсию по сайту?',need:'Хотите быструю экскурсию?',open:'Открыть гида по сайту',how:'Хотите быструю экскурсию?',tour:'Экскурсия по сайту',proj:'Проекты',contact:'Контакты',x:'Закрыть гида',next:'Далее',back:'Назад',end:'Готово',
  s:['Это главная. Здесь мои последние проекты и то, чем я занят сейчас.','Проекты: у каждого видно, что я сделал и как проверял.','Обо мне: кто я и как пришёл в AI.','Работа со мной: небольшие платные проекты и как всё устроено.','Поговорить: беседы и гиды на Topmate.','Команда: Пип, Сора и другие AI-инструменты, которые мне помогают. Решаю и проверяю всё я сам.','В поезде едут комментарии подруг из Японии. Нажмите на окно, чтобы прочитать.'],away:'На главной маленький поезд везёт комментарии подруг из Японии.'},
};
const t = T[lang] ?? T.en; const B = import.meta.env.BASE_URL.replace(/\/$/,'');
---
<div class="gd" data-guide hidden data-t={JSON.stringify(t)} data-b={`${B}/${lang}/`}>
<button type="button" class="gd-tab" aria-expanded="false" aria-controls="gd-p" aria-label={t.open}><Avatar mark/></button>
<button type="button" class="gd-th" hidden tabindex="-1" aria-hidden="true"><span>{t.th}</span><i class="d1"></i><i class="d2"></i></button>
<section id="gd-p" class="gd-p" hidden aria-labelledby="gd-h" tabindex="-1">
<button type="button" class="gd-x" aria-label={t.x}>×</button>
<div class="gd-top"><Avatar mark/><p id="gd-h" class="gd-h">{t.how}</p></div>
<div class="gd-menu"><button type="button" data-g="tour">{t.tour}</button><a href={`${B}/${lang}/projects/`}>{t.proj}</a><a href={`${B}/${lang}/#contact`}>{t.contact}</a></div>
<div class="gd-step" hidden><p class="gd-c small mut" aria-hidden="true"></p><p class="gd-s" aria-live="polite"></p><div class="gd-nav"><button type="button" data-g="back">{t.back}</button><button type="button" data-g="next">{t.next}</button><button type="button" data-g="end">{t.end}</button></div></div>
</section>
</div>
<style is:global>
.gd{position:fixed;left:12px;bottom:12px;z-index:40;font-size:.95rem}
.gd-tab{display:flex;align-items:center;justify-content:center;width:52px;height:52px;padding:0;border:1px solid var(--line);border-radius:50%;background:var(--card);color:var(--fg);cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,.14)}
.gd-tab .mark{width:36px;height:36px}
.gd-tab:focus-visible,.gd-p button:focus-visible,.gd-p a:focus-visible,.gd-th:focus-visible{outline:3px solid var(--acc);outline-offset:2px}
.gd-th{position:absolute;left:44px;bottom:50px;width:max-content;max-width:min(220px,calc(100vw - 72px));font:inherit;font-size:.88rem;line-height:1.3;text-align:left;padding:.55rem .85rem;border:1px solid var(--line);border-radius:24px;background:var(--card);color:var(--fg);box-shadow:0 6px 18px rgba(0,0,0,.12);cursor:pointer;opacity:0;transform:translateY(6px);transition:opacity .5s ease,transform .5s ease}
.gd-th.on{opacity:1;transform:none}.gd-th span{display:block}
.gd-th i{position:absolute;border:1px solid var(--line);background:var(--card);border-radius:50%}.gd-th .d1{width:12px;height:12px;left:4px;bottom:-14px}.gd-th .d2{width:7px;height:7px;left:-4px;bottom:-24px}
footer{padding-bottom:76px}
.gd-p{position:absolute;left:0;bottom:62px;width:min(300px,calc(100vw - 24px));padding:.8rem .8rem .7rem;border:1px solid var(--line);border-radius:16px;background:var(--card);color:var(--fg);box-shadow:0 12px 32px rgba(0,0,0,.16)}
.gd-top{display:flex;align-items:center;gap:.5rem;padding-right:40px}.gd-top .mark{flex:none}.gd-h{margin:0;font-weight:700}
.gd-x{position:absolute;right:.3rem;top:.3rem;width:44px;height:44px;border:0;background:none;color:var(--fg);font-size:1.5rem;cursor:pointer}
.gd-menu,.gd-nav{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.6rem}
.gd-menu>*,.gd-nav button{font:inherit;font-size:.9rem;min-height:44px;display:inline-flex;align-items:center;padding:.2rem .85rem;border:1px solid var(--acc);border-radius:999px;background:transparent;color:var(--acc);text-decoration:none;cursor:pointer}
.gd-nav [data-g=next]{background:var(--acc);color:var(--bg)}.gd-s{margin:.2rem 0 0}.gd-c{margin:.5rem 0 0}
.tour-hl{outline:3px solid var(--warm)!important;outline-offset:4px;border-radius:8px;position:relative;z-index:41}
@media (prefers-reduced-motion:reduce){.gd-th{transition:none;transform:none}}
@media print{.gd{display:none}}
</style>
<script is:inline>
(()=>{const g=document.querySelector('[data-guide]');if(!g)return;const T=JSON.parse(g.dataset.t),B=g.dataset.b;
let off=false;try{if(new URLSearchParams(location.search).get('guide')==='on')localStorage.removeItem('guide');off=localStorage.getItem('guide')==='off'}catch(e){}
const tab=g.querySelector('.gd-tab'),p=g.querySelector('.gd-p'),menu=g.querySelector('.gd-menu'),st=g.querySelector('.gd-step'),s=g.querySelector('.gd-s'),c=g.querySelector('.gd-c'),back=g.querySelector('[data-g=back]'),next=g.querySelector('[data-g=next]');
const sel=['.brand','nav[aria-label=Main] a[href$="/projects/"]','nav[aria-label=Main] a[href$="/about/"]','nav[aria-label=Main] a[href$="/work/"]','nav[aria-label=Main] a[href$="/talk/"]','footer a[href$="/team/"]','[data-train]'];
let k=-1,hl=null;
const clear=()=>{hl&&hl.classList.remove('tour-hl');hl=null};
const step=n=>{clear();k=n;const el=document.querySelector(sel[k]);let txt=T.s[k];if(k===6&&(!el||el.hidden)){txt=T.away}
if(el&&!el.hidden){el.classList.add('tour-hl');hl=el;el.scrollIntoView({block:'center',behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'})}
s.textContent=txt;c.textContent=(k+1)+' / '+sel.length;back.disabled=k===0;next.hidden=k===sel.length-1};
const th=g.querySelector('.gd-th');const hideTh=()=>{th.classList.remove('on');setTimeout(()=>th.hidden=true,500)};
const openP=()=>{hideTh();p.hidden=false;tab.setAttribute('aria-expanded','true');menu.hidden=false;st.hidden=true;p.focus()};
const closeP=()=>{p.hidden=true;tab.setAttribute('aria-expanded','false');clear()};
const show=()=>{g.hidden=false};
th.addEventListener('click',()=>{openP()});
tab.addEventListener('click',()=>p.hidden?openP():closeP());
g.querySelector('[data-g=tour]').addEventListener('click',()=>{menu.hidden=true;st.hidden=false;step(0);next.focus()});
back.addEventListener('click',()=>step(Math.max(0,k-1)));next.addEventListener('click',()=>step(Math.min(sel.length-1,k+1)));
g.querySelector('[data-g=end]').addEventListener('click',()=>{closeP();tab.focus()});
g.querySelector('.gd-x').addEventListener('click',()=>{closeP();g.hidden=true;try{localStorage.setItem('guide','off')}catch(e){}const h=document.querySelector('[data-guide-open]');h&&h.focus()});
g.addEventListener('keydown',e=>{if(e.key==='Escape'&&!p.hidden){closeP();tab.focus()}});
document.querySelectorAll('[data-guide-open]').forEach(b=>b.addEventListener('click',()=>{try{localStorage.removeItem('guide')}catch(e){}show();openP()}));
const sync=()=>{const d=document.querySelector('dialog[open]'),lm=document.querySelector('details.langm[open]');g.style.visibility=(d||lm)?'hidden':''};
new MutationObserver(sync).observe(document.body,{subtree:true,attributes:true,attributeFilter:['open']});
if(!off){show();let seen=false;try{seen=sessionStorage.getItem('gdth')==='1'}catch(e){}
if(!seen)setTimeout(()=>{if(!p.hidden||g.hidden)return;th.hidden=false;requestAnimationFrame(()=>th.classList.add('on'));try{sessionStorage.setItem('gdth','1')}catch(e){}setTimeout(hideTh,9000)},2500)}})();
</script>
