---
// Small circular country marker on a friend's picture (like a flag badge on a profile photo). Decorative; the location is also given in text.
const { code } = Astro.props as { code: 'jp'|'fr'|'ru' };
---
<span class="flagb" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false">
<defs><clipPath id={`fc-${code}`}><circle cx="12" cy="12" r="11"/></clipPath></defs>
<g clip-path={`url(#fc-${code})`}>
{code==='jp' && <><rect width="24" height="24" fill="#fff"/><circle cx="12" cy="12" r="5.2" fill="#BC002D"/></>}
{code==='fr' && <><rect width="8" height="24" fill="#002654"/><rect x="8" width="8" height="24" fill="#fff"/><rect x="16" width="8" height="24" fill="#CE1126"/></>}
{code==='ru' && <><rect width="24" height="8" fill="#fff"/><rect y="8" width="24" height="8" fill="#0039A6"/><rect y="16" width="24" height="8" fill="#D52B1E"/></>}
</g><circle cx="12" cy="12" r="11" fill="none" stroke="rgba(0,0,0,.18)" stroke-width="1"/></svg></span>
