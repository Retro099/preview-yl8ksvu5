document.addEventListener('click',e=>{document.querySelectorAll('details.langm[open]').forEach(d=>{if(!d.contains(e.target))d.open=false})});document.querySelectorAll('[data-lang]').forEach(a=>a.addEventListener('click',()=>{try{localStorage.setItem('lang',a.dataset.lang)}catch(e){}}));
