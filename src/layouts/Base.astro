---
const { lang, page = '', title } = Astro.props;
const ja = lang === 'ja';
const other = ja ? 'en' : 'ja';
const _b = import.meta.env.BASE_URL; const B = _b.endsWith('/') ? _b.slice(0, -1) : _b;
const site = (Astro.site?.href ?? '').replace(/\/$/, '') + B;
const slug = page ? page + '/' : '';
const nav = [['projects', ja?'プロジェクト':'Projects'],['writing', ja?'記事':'Writing'],['about', ja?'自己紹介':'About'],['advice', ja?'相談':'Advice']];
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8"><meta name="robots" content="noindex, nofollow"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title ? `${title} · ` : ''}Prithivi Raj Mohanta</title>
<meta name="description" content={ja?'日本語の業務文書を扱うAIシステムを開発し、精度を数値で検証しています。':'I build Japanese-language AI systems and measure whether they work.'}>
<meta name="color-scheme" content="light dark">
<link rel="alternate" hreflang="en" href={`${site}/en/${slug}`}><link rel="alternate" hreflang="ja" href={`${site}/ja/${slug}`}>
<style is:global>
:root{--bg:#fafaf8;--fg:#17181c;--mut:#5a5c65;--card:#fff;--line:#e4e2dc;--acc:#0a58a8;--soft:#eef3fa}
@media (prefers-color-scheme:dark){:root{--bg:#111215;--fg:#ecebe7;--mut:#a3a5ad;--card:#1a1b1f;--line:#2b2c32;--acc:#82b8ff;--soft:#18243a}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:16.5px/1.7 system-ui,-apple-system,"Segoe UI",Roboto,"Hiragino Sans","Noto Sans JP",Meiryo,sans-serif}
a{color:var(--acc);text-underline-offset:3px}a:focus-visible{outline:3px solid var(--acc);outline-offset:2px}
.wrap{max-width:720px;margin:0 auto;padding:0 1.1rem}
header{border-bottom:1px solid var(--line);position:sticky;top:0;background:var(--bg);z-index:2}
header .wrap{display:flex;flex-wrap:wrap;gap:.3rem 1rem;align-items:center;padding:.7rem 1.1rem}
.brand{font-weight:700;color:var(--fg);text-decoration:none;margin-right:auto}
nav{display:flex;flex-wrap:wrap;gap:.1rem .9rem;font-size:.95rem}nav a{color:var(--mut);text-decoration:none}nav a[aria-current],nav a:hover{color:var(--fg);text-decoration:underline}
.lang{font-size:.88rem;border:1px solid var(--line);border-radius:99px;padding:.05rem .6rem;text-decoration:none}
main{padding:2.2rem 0 3rem}
h1{font-size:clamp(1.55rem,5.2vw,2.15rem);line-height:1.3;margin:0 0 1rem;letter-spacing:-.01em}
h2{font-size:1.2rem;margin:2.6rem 0 .8rem}h3{font-size:1.05rem;margin:0 0 .3rem;line-height:1.45}
.facts{display:grid;grid-template-columns:1fr;gap:.15rem;border:1px solid var(--line);border-radius:12px;padding:.8rem 1rem;background:var(--card);font-size:.95rem;margin:0}
@media (min-width:600px){.facts{grid-template-columns:8.5rem 1fr}}
.facts dt{color:var(--mut)}.facts dd{margin:0 0 .35rem}
.card{display:block;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:1rem 1.1rem;margin:.8rem 0;color:var(--fg);text-decoration:none}
a.card:hover{border-color:var(--acc)}
.repo{font:.8rem ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--mut);margin:0 0 .4rem}
.card ul{margin:.4rem 0 0;padding-left:1.1rem;font-size:.93rem}
.tl{list-style:none;padding:0;margin:0}.tl li{display:grid;grid-template-columns:1fr;padding:.5rem 0;border-bottom:1px solid var(--line)}
@media (min-width:600px){.tl li{grid-template-columns:9.5rem 1fr}}
.tl time,.when{color:var(--mut);font-size:.9rem}
.mut{color:var(--mut)}.en{color:var(--mut);font-size:.9rem;margin:-.55rem 0 1rem}
li .en{margin:.1rem 0 .3rem}
.btn{display:inline-block;padding:.65rem 1.1rem;border-radius:10px;background:var(--acc);color:var(--bg);text-decoration:none;font-weight:600}
rt{font-size:.55em;color:var(--mut)}
section dl.cs dt{font-weight:700;margin-top:1.1rem}section dl.cs dd{margin:.2rem 0 0}
footer{border-top:1px solid var(--line);color:var(--mut);font-size:.9rem;padding:1.2rem 0 2.2rem}footer a{margin-right:1rem}
</style>
</head>
<body>
<header><div class="wrap">
<a class="brand" href={`${B}/${lang}/`}>Prithivi Raj Mohanta</a>
<nav aria-label="Main">{nav.map(([p,l]) => <a href={`${B}/${lang}/${p}/`} aria-current={page.startsWith(p) ? 'page' : undefined}>{l}</a>)}</nav>
<a class="lang" href={`${B}/${other}/${slug}`} hreflang={other} lang={other}>{other==='ja'?'日本語':'EN'}</a>
</div></header>
<main class="wrap"><slot/></main>
<footer><div class="wrap">
<a href="https://github.com/Retro099">GitHub</a><a href="https://topmate.io/prithivi_raj_mohanta">Topmate</a><a href={`${B}/${lang}/now/`}>{ja?'いま':'Now'}</a>
<p>© 2026 Prithivi Raj Mohanta</p>
</div></footer>
</body></html>
