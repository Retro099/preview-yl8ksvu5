---
const { lang, page, title } = Astro.props;
const other = lang === 'en' ? 'ja' : 'en';
const slug = page ? page + '/' : '';
const base = 'https://retro099.github.io/preview-yl8ksvu5';
const _b = import.meta.env.BASE_URL; const B = _b.endsWith('/') ? _b.slice(0, -1) : _b;
const nav = [['', lang==='ja'?'ホーム':'Home'],['projects', lang==='ja'?'プロジェクト':'Projects'],['agent', lang==='ja'?'エージェント':'Agent'],['now', lang==='ja'?'いま':'Now'],['services', lang==='ja'?'相談':'Services'],['about', lang==='ja'?'わたしについて':'About']];
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8"><meta name="robots" content="noindex, nofollow"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title ? `${title} · ` : ''}Prithivi Raj Mohanta</title>
<meta name="description" content={lang==='ja'?'自分の課題を解くツールを作るエンジニア。':'An engineer who builds tools for his own problems, with proof.'}>
<meta name="color-scheme" content="light dark">
<link rel="alternate" hreflang="en" href={`${base}/en/${slug}`}>
<link rel="alternate" hreflang="ja" href={`${base}/ja/${slug}`}>
<link rel="alternate" hreflang="x-default" href={`${base}/en/${slug}`}>
<style is:global>
:root{--bg:#fbfaf7;--fg:#1b1b1f;--mut:#55565e;--card:#fff;--line:#e3e1db;--acc:#0b5cad;--acc2:#e8f0fa}
@media (prefers-color-scheme:dark){:root{--bg:#121316;--fg:#ecebe8;--mut:#a9aab2;--card:#1b1c20;--line:#2c2d33;--acc:#7cb6ff;--acc2:#1a2a40}}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.65 system-ui,-apple-system,"Segoe UI",Roboto,"Hiragino Sans","Noto Sans JP",Meiryo,sans-serif}
a{color:var(--acc)}a:focus-visible,.btn:focus-visible{outline:3px solid var(--acc);outline-offset:2px}
.wrap{max-width:760px;margin:0 auto;padding:0 1.1rem}
header{border-bottom:1px solid var(--line)}header .wrap{display:flex;flex-wrap:wrap;gap:.4rem 1rem;align-items:center;padding:.8rem 1.1rem}
.brand{font-weight:700;text-decoration:none;color:var(--fg);margin-right:auto}
nav{display:flex;flex-wrap:wrap;gap:.2rem .8rem;font-size:.95rem}nav a{text-decoration:none;color:var(--mut)}nav a:hover,nav a[aria-current]{color:var(--fg);text-decoration:underline}
.lang{font-size:.9rem;border:1px solid var(--line);padding:.1rem .55rem;border-radius:99px;text-decoration:none}
main{padding:2rem 0 3rem}h1{font-size:clamp(1.6rem,5vw,2.3rem);line-height:1.25;margin:.2rem 0 1rem}h2{font-size:1.25rem;margin:0 0 .5rem}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:1.1rem 1.2rem;margin:1rem 0;transition:transform .2s,border-color .2s}
.card:hover{border-color:var(--acc)}.muted{opacity:.85}
.num{display:inline-block;background:var(--acc2);color:var(--fg);border-radius:8px;padding:.15rem .5rem;font-weight:700}
.btns{display:flex;flex-wrap:wrap;gap:.6rem;margin:1.4rem 0}
.btn{display:inline-block;padding:.7rem 1.1rem;border-radius:10px;border:1px solid var(--acc);text-decoration:none;font-weight:600;transition:background .2s,color .2s}
.btn.primary,.btn:hover{background:var(--acc);color:var(--bg)}
.en{color:var(--mut);font-size:.92rem;margin-top:-.6rem}
dl dt{font-weight:700;margin-top:.6rem}dl dd{margin:0}
footer{border-top:1px solid var(--line);color:var(--mut);font-size:.9rem;padding:1.2rem 0 2rem}footer a{margin-right:1rem}
@media (prefers-reduced-motion:no-preference){.card{animation:rise .5s ease both}@keyframes rise{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<header><div class="wrap">
<a class="brand" href={`${B}/${lang}/`}>Prithivi Raj Mohanta</a>
<nav aria-label="Main">{nav.map(([p,l]) => <a href={`${B}/${lang}/${p ? p + '/' : ''}`} aria-current={p===page ? 'page' : undefined}>{l}</a>)}</nav>
<a class="lang" href={`${B}/${other}/${slug}`} hreflang={other} lang={other}>{other==='ja'?'日本語':'English'}</a>
</div></header>
<main class="wrap"><slot/></main>
<footer><div class="wrap">
<a href="https://github.com/Retro099">GitHub</a><a href="https://topmate.io/prithivi_raj_mohanta">Topmate</a><a href={`${B}/${other}/${slug}`} hreflang={other}>{other==='ja'?'日本語':'English'}</a>
<p>© 2026 Prithivi Raj Mohanta</p>
</div></footer>
</body></html>
